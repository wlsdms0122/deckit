#!/usr/bin/env bash
# A plugin Deckit ships, brought back after it was removed. Through the installed app's own deckit-cli and modules,
# so this never installs a different version than the app does at launch.
set -euo pipefail

APP=/Applications/Deckit.app/Contents/Resources/app
[ $# -gt 0 ] || { echo "usage: deckit plugins <id>…: which plugin to bring back (Deckit installs the rest at launch)" >&2; exit 1; }
[ -x "$APP/deckit/deckit-cli/deckit-cli" ] || { echo "Deckit.app is not installed (deckit install)" >&2; exit 1; }
exec node "$APP/deckit/deckit-cli/deckit-cli" --app "$APP/config.js" --app "$APP/folders.js" restore "$@"
