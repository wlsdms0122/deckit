#!/usr/bin/env node
// Holds the styles deckit writes to the rules its look keeps. Reads every script under source/deckit, and every page
// it owns: the CSS in its templates and in `<style>` and `style="..."`, and the styles it sets from code
// (`Object.assign(element.style, {...})`, `element.style.name = '...'`, `styled(tag, {...})` and the keyframes
// `element.animate(...)` plays). Bundled code (a mod's engine, node_modules) is not deckit's writing and is left out.
// Exits 1 with a line for each problem, `deckit/<file>:<line>: <rule>: <what>`.
const fs = require('fs');
const path = require('path');

const LIBRARY = require(path.join(__dirname, '..', 'library.js'));

if (process.argv.length > 2) {
    console.error('usage: deckit style (it takes no arguments)');
    process.exit(2);
}

// The rules, each by the name its problems are told under.
const RULES = {
    'colour-literal': 'a colour written out where a token is meant',
    'layout-motion': 'a transition or animation of what lays the page out, or of all of it',
    'tracked-caps': 'text under 16px in capitals or tracked wider than 0.03em',
    'side-stripe': 'one side drawn 2px or more and wider than the others',
    glow: 'a shadow with no offset in a colour that is not grey',
    'small-text': 'text under 11px',
    'off-scale-text': 'text in a size off the type scale',
    'opacity-text': 'text made faint by opacity rather than drawn in muted or disabled',
    'font-weight': 'a weight other than 400 and 600',
    'radius-literal': 'a radius written out where a token is meant',
    'duration-literal': 'a duration written out where a token is meant',
    'edge-and-elevation': 'a 1px border and a wide soft shadow on one surface',
    'z-index': 'a z-index of its own beside the layers of PLACE.Z',
};
// What lays the page out: a change to any of it lays the page out again on every frame it moves.
const LAYOUT = new RegExp(
    `^(?:${[
        '(?:min-|max-)?(?:width|height)',
        'top',
        'left',
        'right',
        'bottom',
        'inset(?:-[a-z-]+)?',
        '(?:margin|padding)(?:-[a-z-]+)?',
        'border(?:-[a-z]+)?-width',
    ].join('|')})$`
);
// The kit's layers (deckit-sdk/shell/ui/place, PLACE.Z), reached by name: a literal z-index orders a part's own
// children, from -1 to 1, or makes a layer of its own.
const Z_OWN = 1;
// The places a rule does not hold, each with why: those whose job is a colour written out, then the system's own
// chrome and a loop. `selector` narrows one to its rules, `(code)` being the strings in a script's code and `(inline)`
// what it sets on an element. Anything else draws with the token.
const ALLOWED = [
    { file: 'deckit-sdk/shell/ui/token/index.js', why: 'the token, where the colours are' },
    { file: 'deckit-app/theme/theme.js', selector: /^\(code\)$/, why: "the host app's colours, the token's ground" },
    {
        file: 'deckit-sdk/shell/ui/color/index.js',
        selector: /^\(code\)$/,
        why: "the inks text takes over a colour of the content's own",
    },
    {
        file: 'deckit-sdk/shell/ui/color-picker/index.js',
        selector: /^(?:\.deckit-color-(?:area|hue|knob)\b|\(code\)$)/,
        why: 'the colours a person picks from and the colour picked, and the knob drawn over any of them',
    },
    {
        file: 'deckit-electron/web/renderer.js',
        selector: /^\((?:inline|code)\)$/,
        why: "a web page's ground, white as the web's is",
    },
    // A colour of the content's own is data.
    {
        file: 'mods/calendar/src/accounts/account-editor.js',
        selector: /^\(code\)$/,
        why: 'the colours a calendar takes',
    },
    { file: 'mods/browser/src/sidebar/outline.js', selector: /^\(code\)$/, why: 'the colours a folder takes' },
    { file: 'mods/editor/src/file-type/file-type.js', selector: /^\(code\)$/, why: "each file type's colour" },
    {
        file: 'deckit-shell/shell/desktop/frame.js',
        selector: /^\.deckit-window-button\b/,
        why: "a window's buttons, each in the colour of its own the system draws it in, whatever the look",
    },
].map((allow) => ({ rule: 'colour-literal', ...allow }));
// A spinner turns at a pace of its own for as long as it shows: a loop, not a change that a length of motion times.
ALLOWED.push({ file: 'deckit-sdk/shell/ui/loading/index.js', selector: /^\(inline\)$/, rule: 'duration-literal' });
// Engines' bundles: a mod's src/engine/engine.js, which `deckit engine` makes from the packages it bundles.
const BUNDLED = /^mods\/[^/]+\/src\/engine\/engine\.js$/;
const NAMED_COLOURS = new Set(
    (
        'aliceblue antiquewhite aqua aquamarine azure beige bisque black blanchedalmond blue blueviolet brown ' +
        'burlywood cadetblue chartreuse chocolate coral cornflowerblue cornsilk crimson cyan darkblue ' +
        'darkcyan darkgoldenrod darkgray darkgreen darkgrey darkkhaki darkmagenta darkolivegreen darkorange ' +
        'darkorchid darkred darksalmon darkseagreen darkslateblue darkslategray darkslategrey darkturquoise ' +
        'darkviolet deeppink deepskyblue dimgray dimgrey dodgerblue firebrick floralwhite forestgreen fuchsia ' +
        'gainsboro ghostwhite gold goldenrod gray green greenyellow grey honeydew hotpink indianred indigo ' +
        'ivory khaki lavender lavenderblush lawngreen lemonchiffon lightblue lightcoral lightcyan ' +
        'lightgoldenrodyellow lightgray lightgreen lightgrey lightpink lightsalmon lightseagreen lightskyblue ' +
        'lightslategray lightslategrey lightsteelblue lightyellow lime limegreen linen magenta maroon ' +
        'mediumaquamarine mediumblue mediumorchid mediumpurple mediumseagreen mediumslateblue ' +
        'mediumspringgreen mediumturquoise mediumvioletred midnightblue mintcream mistyrose moccasin ' +
        'navajowhite navy oldlace olive olivedrab orange orangered orchid palegoldenrod palegreen ' +
        'paleturquoise palevioletred papayawhip peachpuff peru pink plum powderblue purple rebeccapurple red ' +
        'rosybrown royalblue saddlebrown salmon sandybrown seagreen seashell sienna silver skyblue slateblue ' +
        'slategray slategrey snow springgreen steelblue tan teal thistle tomato turquoise violet wheat white ' +
        'whitesmoke yellow yellowgreen'
    ).split(' ')
);
const GREY_NAMES = /^(?:black|white|gr[ae]y|silver|gainsboro|whitesmoke|snow|(?:dark|dim|light|slate)gr[ae]y)$/;
// Where a word in a value is a name and never a colour.
const NAMES_ONLY =
    /^(?:font(?:-family)?|transition(?:-property)?|animation(?:-name)?|will-change|grid-[a-z-]+|content)$/;
// What draws no text, so it may be made fainter by opacity: a picture, an icon and its parts.
const ICONIC = new RegExp(
    [
        'icon',
        'svg',
        'circle',
        'path',
        'glyph',
        'img',
        'image',
        'picture',
        'thumb',
        'swatch',
        'dot',
        'spinner',
        'chevron',
        'caret',
        'arrow',
        'grip',
        'handle',
        'knob',
        'logo',
        'canvas',
        'tick',
        '::?before',
        '::?after',
    ].join('|'),
    'i'
);
// What reads a colour for its alpha alone: a mask.
const ALPHA_ONLY = /^(?:-webkit-)?mask(?:-image)?$/;
// A colour written out: a hex, or a colour function of numbers.
const COLOUR_FUNCTION = /\b(?:rgba?|hsla?|hwb|lab|lch|oklab|oklch)\(\s*[-\d.]/gi;
const HEX = /#(?:[0-9a-f]{8}|[0-9a-f]{6}|[0-9a-f]{3,4})\b/gi;

const TOKEN = tokenOf(path.join(LIBRARY.DECKIT, 'deckit-sdk', 'shell', 'ui', 'token', 'index.js'));
const problems = [];
const files = sources();
for (const file of files) {
    const text = fs.readFileSync(path.join(LIBRARY.DECKIT, file), 'utf8');
    const lines = linesOf(text);
    const told = new Set();
    // One problem is told once for its line, where it is read both as a style and as a string in code.
    const say = (rule, at, what) => {
        const line = lines(at);
        const key = `${line} ${rule} ${what.key ?? what.text}`;
        if (told.has(key) || allowed(file, rule, what.selector)) return;
        told.add(key);
        problems.push({ file, line, rule, what: what.text });
    };
    const styles = file.endsWith('.html') ? fromPage(text) : fromScript(text);
    for (const style of styles) hold(style, say);
}

problems.sort((a, b) => a.file.localeCompare(b.file) || a.line - b.line);
if (problems.length) {
    for (const { file, line, rule, what } of problems) console.error(`deckit/${file}:${line}: ${rule}: ${what}`);
    for (const [rule, meaning] of Object.entries(RULES)) {
        const count = problems.filter((problem) => problem.rule === rule).length;
        if (count) console.error(`${rule}: ${count}, ${meaning}`);
    }
    console.error(`${problems.length} problem${problems.length === 1 ? '' : 's'}`);
    process.exit(1);
}
console.log(`ok: the styles of ${files.length} files keep the rules (${Object.keys(RULES).join(', ')})`);

// MARK: - What is read

// The scripts and pages under source/deckit, by their paths there, but for what is bundled.
function sources() {
    const walk = (folder) =>
        fs.readdirSync(path.join(LIBRARY.DECKIT, folder), { withFileTypes: true }).flatMap((entry) => {
            const relative = folder ? `${folder}/${entry.name}` : entry.name;
            if (entry.isDirectory()) return ['node_modules', '.build'].includes(entry.name) ? [] : walk(relative);
            return /\.(?:m?js|html)$/.test(entry.name) && !BUNDLED.test(relative) ? [relative] : [];
        });
    return walk('').sort();
}

// The 1-based line of an offset in `text`.
function linesOf(text) {
    const starts = [0];
    for (let at = text.indexOf('\n'); at >= 0; at = text.indexOf('\n', at + 1)) starts.push(at + 1);
    return (offset) => {
        let low = 0;
        let high = starts.length - 1;
        while (low < high) {
            const middle = (low + high + 1) >> 1;
            if (starts[middle] <= offset) low = middle;
            else high = middle - 1;
        }
        return low + 1;
    };
}

// What the token is, read from its module: the type scale in px, each colour's custom property and whether it is
// grey, and each shadow's custom property and value, a look's own read from the light one. A token that cannot be
// read is said, as the rules need it.
function tokenOf(file) {
    const text = fs.readFileSync(file, 'utf8');
    const objectAfter = (pattern, from = 0) => {
        const at = text.slice(from).search(pattern);
        if (at < 0)
            throw new Error(`deckit style: ${pattern} is not in the token (${path.relative(LIBRARY.DECKIT, file)})`);
        const open = text.indexOf('{', from + at);
        return { body: text.slice(open + 1, closing(text, open)), at: open };
    };
    const pairs = (body) =>
        [...body.matchAll(/^\s*(\w+):\s*([^\n]+?),?\s*$/gm)].map(([, name, value]) => [name, value]);
    const literalOf = (value) => /^'([^']*)'$/.exec(value)?.[1];
    const type = Object.fromEntries(
        [...objectAfter(/const TYPE\s*=/).body.matchAll(/(\w+):\s*\{\s*size:\s*(\d+(?:\.\d+)?)/g)].map(
            ([, name, size]) => [name, Number(size)]
        )
    );
    const light = objectAfter(/\blight:\s*\{/, objectAfter(/const LOOKS\s*=/).at);
    const look = Object.fromEntries(pairs(light.body).map(([name, value]) => [name, literalOf(value)]));
    const made = objectAfter(/function tokenOf\b/).at;
    const colours = {};
    for (const [name, value] of pairs(objectAfter(/\bcolor:\s*\{/, made).body)) {
        const literal = literalOf(value) ?? (/^look\.(\w+)$/.exec(value) && look[/^look\.(\w+)$/.exec(value)[1]]);
        // A wash, and a step from the text to the background, are greys of the theme's own.
        colours[kebab(name)] = literal ? greyOf(literal) : /^(?:WASH|toward|text|background)\b/.test(value);
    }
    const shadows = {};
    for (const [name, value] of [
        ...pairs(objectAfter(/\bshadow:\s*\{/, made).body),
        ...pairs(objectAfter(/\bshadow:\s*\{/, light.at).body),
    ]) {
        const literal = literalOf(value);
        if (literal) shadows[kebab(name)] = literal;
    }
    if (!Object.keys(type).length || !Object.keys(colours).length || !Object.keys(shadows).length)
        throw new Error('deckit style: the token has no type scale, colours or shadows as it is read');
    return { type, scale: new Set(Object.values(type)), colours, shadows };
}

// The styles a page holds: each `<style>` and each `style="..."`.
function fromPage(text) {
    return stylesOfMarkup(text, 0);
}

// The styles a script writes: the CSS in its templates and strings, and the styles it sets from code.
function fromScript(source) {
    const text = blank(source);
    const styles = [];
    for (const { start, end } of templatesOf(text, 0, text.length)) {
        const body = text.slice(start, end);
        const held = templateText(body);
        const css = cssOf(held, start);
        if (css) styles.push(css);
        styles.push(...stylesOfMarkup(held, start));
    }
    styles.push(...stylesOfCode(text));
    styles.push(coloursOfCode(text));
    return styles;
}

// Every string in code that is a colour and nothing else, as a style a script writes, which it puts in a template or
// sets on an element.
function coloursOfCode(text) {
    const declarations = [];
    const colour = /^\s*(?:#(?:[0-9a-f]{8}|[0-9a-f]{6}|[0-9a-f]{3,4})|(?:rgba?|hsla?)\([\d.,%\s/]+\))\s*$/i;
    for (let at = 0; at < text.length;) {
        const character = text[at];
        if (character === '"' || character === "'" || character === '`') {
            const end = character === '`' ? templateEnd(text, at) : stringEnd(text, at);
            const body = text.slice(at + 1, end - 1);
            if (colour.test(body)) declarations.push({ name: 'code', value: body.trim(), at });
            at = end;
        } else if (character === '/' && regexStarts(text.slice(Math.max(0, at - 40), at))) at = regexEnd(text, at);
        else at++;
    }
    return { rules: [{ selector: '(code)', at: 0, declarations }] };
}

// `text` with its comments blanked to spaces, its lines kept, so every offset stays where it is.
function blank(text) {
    let out = '';
    let at = 0;
    const blanked = (part) => part.replace(/[^\n]/g, ' ');
    while (at < text.length) {
        const character = text[at];
        const next = text[at + 1];
        if (character === '/' && next === '*') {
            const end = text.indexOf('*/', at + 2);
            const stop = end < 0 ? text.length : end + 2;
            out += blanked(text.slice(at, stop));
            at = stop;
        } else if (character === '/' && next === '/') {
            const end = text.indexOf('\n', at);
            const stop = end < 0 ? text.length : end;
            out += blanked(text.slice(at, stop));
            at = stop;
        } else if (character === '"' || character === "'") {
            const stop = stringEnd(text, at);
            out += text.slice(at, stop);
            at = stop;
        } else if (character === '`') {
            const stop = templateEnd(text, at);
            out += text.slice(at, stop);
            at = stop;
        } else if (character === '/' && regexStarts(out)) {
            const stop = regexEnd(text, at);
            out += text.slice(at, stop);
            at = stop;
        } else {
            out += character;
            at++;
        }
    }
    return out;
}

function regexStarts(before) {
    const last = before.trimEnd().slice(-1);
    return last === '' || '(,=:[!&|?{};+-*%<>~^'.includes(last) || /\breturn\s*$/.test(before);
}

function stringEnd(text, at) {
    const quote = text[at++];
    while (at < text.length && text[at] !== quote && text[at] !== '\n') at += text[at] === '\\' ? 2 : 1;
    return at + 1;
}

function regexEnd(text, at) {
    at++;
    let inClass = false;
    while (at < text.length && (inClass || text[at] !== '/') && text[at] !== '\n') {
        if (text[at] === '\\') at++;
        else if (text[at] === '[') inClass = true;
        else if (text[at] === ']') inClass = false;
        at++;
    }
    return at + 1;
}

// The end of the template that starts at `at`, past its closing backtick, through what it puts in.
function templateEnd(text, at) {
    at++;
    while (at < text.length && text[at] !== '`') {
        if (text[at] === '\\') at += 2;
        else if (text[at] === '$' && text[at + 1] === '{') at = codeEnd(text, at + 2);
        else at++;
    }
    return at + 1;
}

// The end of code put in a template from `at`, past its closing brace.
function codeEnd(text, at) {
    let depth = 1;
    while (at < text.length) {
        const character = text[at];
        if (character === '"' || character === "'") at = stringEnd(text, at);
        else if (character === '`') at = templateEnd(text, at);
        else if (character === '{') (depth++, at++);
        else if (character === '}') {
            if (!--depth) return at + 1;
            at++;
        } else at++;
    }
    return at;
}

// Where an object literal or a block that opens at `open` closes.
function closing(text, open) {
    let depth = 0;
    let at = open;
    while (at < text.length) {
        const character = text[at];
        if (character === '"' || character === "'") at = stringEnd(text, at);
        else if (character === '`') at = templateEnd(text, at);
        else {
            if (character === '{' || character === '(' || character === '[') depth++;
            else if (character === '}' || character === ')' || character === ']') if (!--depth) return at;
            at++;
        }
    }
    return text.length;
}

// Every template between `from` and `to`, the ones put in another too, each `{ start, end }` around its text.
function templatesOf(text, from, to) {
    const found = [];
    let at = from;
    while (at < to) {
        const character = text[at];
        if (character === '"' || character === "'") at = stringEnd(text, at);
        else if (
            character === '/' &&
            text[at + 1] !== '/' &&
            text[at + 1] !== '*' &&
            regexStarts(text.slice(Math.max(0, at - 40), at))
        )
            at = regexEnd(text, at);
        else if (character === '`') {
            const end = templateEnd(text, at);
            found.push({ start: at + 1, end: end - 1 });
            for (let inner = at + 1; inner < end - 1; inner++) {
                if (text[inner] === '\\') inner++;
                else if (text[inner] === '$' && text[inner + 1] === '{') {
                    const stop = codeEnd(text, inner + 2);
                    found.push(...templatesOf(text, inner + 2, stop - 1));
                    inner = stop - 1;
                }
            }
            at = end;
        } else at++;
    }
    return found;
}

// A template's text as CSS reads it: what it puts in stands as underscores, as long as it was, its lines kept, so
// no value is guessed at and every offset stays where it is.
function templateText(body) {
    let out = '';
    for (let at = 0; at < body.length;) {
        if (body[at] === '\\') {
            out += body.slice(at, at + 2);
            at += 2;
        } else if (body[at] === '$' && body[at + 1] === '{') {
            const stop = codeEnd(body, at + 2);
            out += body.slice(at, stop).replace(/[^\n]/g, '_');
            at = stop;
        } else out += body[at++];
    }
    return out;
}

// The rules CSS text at `offset` holds, or null when it is no CSS: a style is `{ rules }`, each rule
// `{ selector, at, keyframes, declarations: [{ name, value, at }] }`, every `at` an offset in the file.
function cssOf(text, offset) {
    const plain = text.replace(/\/\*[\s\S]*?\*\//g, (comment) => comment.replace(/[^\n]/g, ' '));
    const rules = [];
    let bad = 0;
    const parse = (from, to, scope) => {
        let at = from;
        let start = from;
        const declarations = [];
        while (at < to) {
            const character = plain[at];
            if (character === '"' || character === "'") at = stringEnd(plain, at);
            else if (character === '(') at = closing(plain, at) + 1;
            else if (character === ';' || character === '}') {
                const piece = plain.slice(start, at);
                if (piece.trim()) {
                    const declaration = declarationOf(piece, offset + start);
                    if (declaration) declarations.push(declaration);
                    else bad++;
                }
                if (character === '}') bad++;
                start = ++at;
            } else if (character === '{') {
                const prelude = plain.slice(start, at).trim();
                const close = closing(plain, at);
                const atOffset =
                    offset + start + (plain.slice(start, at).length - plain.slice(start, at).trimStart().length);
                if (/^@(?:media|supports|container|layer|document)\b/.test(prelude)) parse(at + 1, close, scope);
                else if (/^@(?:-webkit-)?keyframes\b/.test(prelude))
                    parse(at + 1, close, { keyframes: prelude, at: atOffset });
                else if (selectorLike(prelude) || (scope.keyframes && /^(?:from|to|[\d.%\s,]+)$/.test(prelude))) {
                    const inner = parse(at + 1, close, scope.keyframes ? scope : { selector: prelude });
                    rules.push({
                        selector: scope.keyframes ? scope.keyframes : selectorOf(scope.selector, prelude),
                        keyframes: !!scope.keyframes,
                        at: scope.keyframes ? scope.at : atOffset,
                        declarations: inner,
                    });
                } else bad++;
                at = close + 1;
                start = at;
            } else at++;
        }
        const tail = plain.slice(start, to);
        if (tail.trim()) {
            const declaration = declarationOf(tail, offset + start);
            if (declaration) declarations.push(declaration);
            else if (scope.selector !== undefined || scope.keyframes) bad++;
        }
        return declarations;
    };
    const top = parse(0, plain.length, {});
    const held = rules.reduce((count, rule) => count + rule.declarations.length, 0);
    // A list of declarations alone is CSS as a style attribute or cssText holds it.
    if (!rules.length && top.length >= 2 && !bad)
        return { rules: [{ selector: '(inline)', at: offset, declarations: top }] };
    if (!held || bad > held / 4) return null;
    return { rules };
}

function selectorOf(outer, inner) {
    if (!outer) return inner;
    return inner.includes('&') ? inner.replace(/&/g, outer) : `${outer} ${inner}`;
}

// Whether text before a block reads as a selector, not code.
function selectorLike(prelude) {
    if (!prelude || prelude.length > 400) return false;
    if (/[;`]|=>|\b(?:function|const|let|var|return|if|else|for|while|new|typeof)\b/.test(prelude)) return false;
    return !/=/.test(prelude.replace(/\[[^\]]*\]/g, '').replace(/\([^)]*\)/g, ''));
}

// A declaration, `{ name, value, at }`, or null when the text is none.
function declarationOf(piece, at) {
    const match = /^(\s*)(--[\w-]+|-?[a-z][a-z-]*)\s*:([\s\S]*)$/.exec(piece);
    if (!match) return null;
    const value = match[3].replace(/!important\s*$/, '').trim();
    if (!value || /=>|==|&&|\|\||\breturn\b|[{}]/.test(value)) return null;
    return { name: match[2].toLowerCase(), value, at: at + match[1].length };
}

// The styles in markup: each `<style>`'s CSS and each `style="..."`'s declarations.
function stylesOfMarkup(text, offset) {
    const styles = [];
    for (const match of text.matchAll(/<style\b[^>]*>([\s\S]*?)<\/style>/gi)) {
        const css = cssOf(match[1], offset + match.index + match[0].indexOf('>') + 1);
        if (css) styles.push(css);
    }
    for (const match of text.matchAll(/\sstyle=(["'])([^"']*)\1/gi)) {
        const start = offset + match.index + match[0].indexOf(match[1]) + 1;
        const declarations = match[2].split(';').reduce(
            (list, piece) => {
                const declaration = declarationOf(piece, start + list.length);
                list.length += piece.length + 1;
                if (declaration) list.found.push(declaration);
                return list;
            },
            { length: 0, found: [] }
        ).found;
        if (declarations.length) styles.push({ rules: [{ selector: '(style attribute)', at: start, declarations }] });
    }
    return styles;
}

// The styles a script sets from code: each object of names and values set on an element's style, each name set on
// one alone, and the keyframes it plays. A value that is code is left out, but for the strings it names a colour or
// a property to transition in, which are taken as fragments.
function stylesOfCode(text) {
    const styles = [];
    const inline = (declarations, at) =>
        declarations.length && styles.push({ rules: [{ selector: '(inline)', at, declarations }] });
    const objectAt = (open) => declarationsOfObject(text, open);
    const plain = codeOnly(text);
    for (const match of text.matchAll(/\bObject\.assign\(\s*[\w$.[\]()?]+\.style\s*,\s*\{/g))
        inline(objectAt(match.index + match[0].length - 1), match.index);
    for (const match of text.matchAll(/\bstyled\(\s*(['"])\w+\1\s*,\s*\{/g))
        inline(objectAt(match.index + match[0].length - 1), match.index);
    for (const match of text.matchAll(/\.style\.([a-zA-Z]+)\s*=(?![=>])\s*/g)) {
        const start = match.index + match[0].length;
        const end = expressionEnd(text, start);
        const name = match[1] === 'cssText' ? null : kebab(match[1]);
        if (name) inline(valuesOf(name, text.slice(start, end), start), match.index);
    }
    for (const match of text.matchAll(/\.style\.setProperty\(\s*(['"])([-\w]+)\1\s*,\s*/g)) {
        const start = match.index + match[0].length;
        inline(valuesOf(match[2], text.slice(start, expressionEnd(text, start)), start), match.index);
    }
    // A theme's rules written as objects, each keyed by its selector.
    for (const match of text.matchAll(/(['"])([.&:#[*][^'"\n]*)\1\s*:\s*\{/g)) {
        if (plain[match.index + 1] !== ' ') continue;
        const declarations = objectAt(match.index + match[0].length - 1);
        if (declarations.length) styles.push({ rules: [{ selector: match[2], at: match.index, declarations }] });
    }
    // A transition made in code and set from an object later, its properties named in strings.
    for (const match of plain.matchAll(/[{,]\s*transition\s*:\s*/g)) {
        const start = match.index + match[0].length;
        inline(valuesOf('transition', text.slice(start, expressionEnd(text, start)), start), start);
    }
    for (const match of text.matchAll(/\.animate\(\s*/g)) {
        const start = match.index + match[0].length;
        const named = /^[A-Z_$][\w$]*/.exec(text.slice(start))?.[0];
        const open = named ? arrayNamed(text, named) : text[start] === '[' ? start : -1;
        if (open < 0) continue;
        const close = closing(text, open);
        const declarations = [];
        for (let at = open + 1; at < close; at++) {
            if (text[at] !== '{') continue;
            declarations.push(...objectAt(at));
            at = closing(text, at);
        }
        if (declarations.length)
            styles.push({ rules: [{ selector: '(animate)', keyframes: true, at: match.index, declarations }] });
        const length = durationOf(text, named ? start + named.length : close + 1);
        if (length) inline([{ name: 'animation-duration', value: length, at: match.index }], match.index);
    }
    return styles;
}

// The duration an `animate()` call's options, after its keyframes at `at`, give when it is written out: a number, or a
// constant of the file's that is one, as `240ms` or `NAME (240ms)`; else null.
function durationOf(text, at) {
    const options = /^\s*,\s*\{/.exec(text.slice(at));
    if (!options) return null;
    const open = at + options[0].length - 1;
    const duration = /(?:^|[{,\s])duration\s*:\s*([\w$.]+)\s*[,}\n]/.exec(text.slice(open, closing(text, open) + 1));
    if (!duration) return null;
    if (/^\d+(?:\.\d+)?$/.test(duration[1])) return duration[1] + 'ms';
    const name = duration[1].replace(/\$/g, '\\$');
    const constant = new RegExp(`\\bconst\\s+${name}\\s*=\\s*(\\d+(?:\\.\\d+)?)\\s*;`).exec(text);
    return constant ? `${duration[1]} (${constant[1]}ms)` : null;
}

// `text` with what its strings and templates hold blanked, the quotes kept, so a word in one is not taken for code.
function codeOnly(text) {
    let out = '';
    for (let at = 0; at < text.length;) {
        const character = text[at];
        if (character === '"' || character === "'" || character === '`') {
            const end = character === '`' ? templateEnd(text, at) : stringEnd(text, at);
            out += character + text.slice(at + 1, end - 1).replace(/[^\n]/g, ' ') + character;
            at = end;
        } else out += text[at++];
    }
    return out;
}

// Where the array a constant `name` is made of opens, or -1.
function arrayNamed(text, name) {
    const match = new RegExp(`\\bconst\\s+${name.replace(/\$/g, '\\$')}\\s*=\\s*(?:Object\\.freeze\\(\\s*)?\\[`).exec(
        text
    );
    return match ? match.index + match[0].length - 1 : -1;
}

// Where an expression from `at` ends: at a `;`, a line's end or a `,` or `)` it is not inside.
function expressionEnd(text, at) {
    let depth = 0;
    while (at < text.length) {
        const character = text[at];
        if (character === '"' || character === "'") at = stringEnd(text, at);
        else if (character === '`') at = templateEnd(text, at);
        else {
            if ('([{'.includes(character)) depth++;
            else if (')]}'.includes(character)) {
                if (!depth) return at;
                depth--;
            } else if (!depth && (character === ';' || character === ',')) return at;
            else if (!depth && character === '\n' && !goesOn(text, at)) return at;
            at++;
        }
    }
    return at;
}

// Whether an expression goes on past the line's end at `at`: the line ends in an operator, or the next starts with one.
function goesOn(text, at) {
    const before = text.slice(0, at).trimEnd();
    const after = text.slice(at).trimStart();
    return !before.endsWith(')') && (/[=?:+\-*/|&(,]$/.test(before) || /^(?:[?:+\-*/|&.]|\$\{)/.test(after));
}

// The declarations an object literal that opens at `open` holds: each key a property in camel case or quoted.
function declarationsOfObject(text, open) {
    const close = closing(text, open);
    const declarations = [];
    let at = open + 1;
    while (at < close) {
        const key = /^\s*(?:(['"])([-\w]+)\1|([a-zA-Z_$][\w$]*))\s*:\s*/.exec(text.slice(at, close));
        if (!key) {
            at = expressionEnd(text, at) + 1;
            continue;
        }
        const start = at + key[0].length;
        const end = Math.min(expressionEnd(text, start), close);
        if (text[start] === '{') {
            at = end + 1;
            continue;
        }
        const name = key[2] ?? kebab(key[3]);
        declarations.push(...valuesOf(name, text.slice(start, end), at + key[0].length - key[0].trimStart().length));
        at = end + 1;
    }
    return declarations;
}

// What code sets a property to: each value it may be when it is literals alone (`'a'`, `c ? 'a' : 'b'`, a number),
// or else the strings in it as fragments, which only a colour or a property to transition is read from.
function valuesOf(name, code, at) {
    const literal = /^\s*(?:(['"])([^'"\n]*)\1|`([^`$]*)`|(-?\d+(?:\.\d+)?))\s*$/.exec(code);
    if (literal) return [{ name, value: literal[2] ?? literal[3] ?? literal[4], at }];
    const strings = [...code.matchAll(/(['"])([^'"\n]*)\1|`([^`]*)`/g)].map((match) =>
        templateText(match[2] ?? match[3])
    );
    const choices = code.replace(/(['"])[^'"\n]*\1|`[^`]*`/g, 'S');
    if (strings.length && /^[\s\w.$!=<>()&|?:'"]*$/.test(choices) && /\?|\|\||\?\?/.test(choices) && !/\+/.test(code))
        return strings.map((value) => ({ name, value, at }));
    return strings.map((value) => ({ name, value, at, fragment: true }));
}

// MARK: - The rules

// Holds one style to every rule, telling each problem by `say(rule, offset, { text, selector, key })`, `key` what tells
// it apart from another of its rule on its line, its text where none is given.
function hold({ rules }, say) {
    for (const rule of rules) {
        const tell = (name, at, text, key) =>
            say(name, at, { text: `${text} (${shown(rule.selector)})`, selector: rule.selector, key });
        const whole = rule.declarations.filter(({ fragment }) => !fragment);
        for (const declaration of rule.declarations) {
            colourLiterals(declaration, tell);
            layoutMotion(declaration, rule, tell);
            durationLiteral(declaration, tell);
            if (declaration.fragment) continue;
            smallText(declaration, tell);
            offScaleText(declaration, tell);
            fontWeight(declaration, tell);
            radiusLiteral(declaration, tell);
            zIndex(declaration, tell);
            glow(declaration, rule, tell);
            if (!rule.keyframes) opacityText(declaration, rule.selector, tell);
        }
        if (rule.keyframes) continue;
        trackedCaps(whole, tell);
        sideStripe(whole, rule.selector, tell);
        edgeAndElevation(whole, tell);
    }
}

function shown(selector) {
    const flat = selector.replace(/\s+/g, ' ').trim();
    return flat.length > 60 ? flat.slice(0, 57) + '...' : flat;
}

function allowed(file, rule, selector = '') {
    return ALLOWED.some(
        (allow) =>
            allow.file === file && allow.rule === rule && (!allow.selector || allow.selector.test(selector.trim()))
    );
}

function colourLiterals({ name, value, at }, tell) {
    if (ALPHA_ONLY.test(name)) return;
    const plain = value.replace(/(['"])[^'"]*\1/g, '');
    const found = [
        ...(plain.match(HEX) || []),
        ...[...plain.matchAll(COLOUR_FUNCTION)].map((match) => {
            const close = closing(plain, match.index + match[0].indexOf('('));
            return plain.slice(match.index, close + 1);
        }),
    ];
    if (!NAMES_ONLY.test(name))
        for (const word of plain.toLowerCase().match(/(?<![-\w#$])[a-z]+(?![-\w(])/g) || [])
            if (NAMED_COLOURS.has(word)) found.push(word);
    for (const colour of new Set(found.map((each) => each.replace(/\s+/g, ''))))
        tell('colour-literal', at, name === 'code' ? `${colour} in code` : `${colour} in ${name}`, colour);
}

function layoutMotion({ name, value, at, fragment }, rule, tell) {
    if (rule.keyframes) {
        if (LAYOUT.test(name)) tell('layout-motion', at, `${name} animated`);
        return;
    }
    if (name !== 'transition' && name !== 'transition-property') return;
    const moved = split(value, ',').map((part) => part.trim().split(/\s+/)[0]);
    for (const property of moved) {
        if (property === 'all' && !fragment) tell('layout-motion', at, `transition: all`);
        else if (LAYOUT.test(property)) tell('layout-motion', at, `${property} transitioned`);
    }
}

function smallText({ name, value, at }, tell) {
    const size = name === 'font-size' ? sizeOf(value) : name === 'font' ? sizeOfFont(value) : null;
    if (size !== null && size < 11) tell('small-text', at, `${name}: ${value}`);
}

// A size the scale has not, 11px or more: what is under it is small text.
function offScaleText({ name, value, at }, tell) {
    const size = name === 'font-size' ? sizeOf(value) : name === 'font' ? sizeOfFont(value) : null;
    if (size === null || size < 11 || TOKEN.scale.has(size) || /var\(--deckit-text-size\)/.test(value)) return;
    tell('off-scale-text', at, `${name}: ${value}`);
}

// A weight set alone or first in the `font` shorthand.
function fontWeight({ name, value, at }, tell) {
    const weights = name === 'font-weight' ? [value.trim()] : name === 'font' ? leadOfFont(value) : [];
    for (const weight of weights)
        if (/^(?:[1-9]00|bold|bolder|lighter)$/.test(weight) && !/^[46]00$/.test(weight))
            tell('font-weight', at, `${name}: ${value}`);
}

// A radius in px but none, where the token's `--deckit-radius-*` is meant. One worked out from the token is its own.
function radiusLiteral({ name, value, at }, tell) {
    if (!/^border(?:-[a-z]+)*-radius$/.test(name) || /var\(/.test(value)) return;
    if (/(?<![\w.$-])(?:\d*\.)?\d+px\b/.test(value.replace(/(?<![\w.$-])0?\.?0+px\b/g, '')))
        tell('radius-literal', at, `${name}: ${value}`);
}

// A length of motion in ms or s but none, where `--deckit-fade`, `--deckit-move-*` or `theme.motion` is meant.
function durationLiteral({ name, value, at }, tell) {
    if (!/^(?:transition|animation)(?:-duration|-delay)?$/.test(name)) return;
    for (const match of value.matchAll(/(?<![\w.$-])((?:\d*\.)?\d+)(ms|s)\b/g))
        if (Number(match[1])) tell('duration-literal', at, `${name}: ${value.trim()}`, match[0]);
}

// Opacity under full on what holds text: an icon, a picture or a part that only comes and goes may take it.
function opacityText({ name, value, at }, selector, tell) {
    if (name !== 'opacity') return;
    const percent = /^([\d.]+)%$/.exec(value.trim());
    const amount = percent ? Number(percent[1]) / 100 : /^[\d.]+$/.test(value.trim()) ? Number(value) : NaN;
    if (!(amount > 0 && amount < 1) || ICONIC.test(selector)) return;
    tell('opacity-text', at, `opacity: ${value.trim()}`);
}

function zIndex({ name, value, at }, tell) {
    if (name !== 'z-index' || !/^-?\d+$/.test(value.trim())) return;
    if (Math.abs(Number(value)) > Z_OWN) tell('z-index', at, `z-index: ${value.trim()}`);
}

function glow({ name, value, at }, rule, tell) {
    if (!['box-shadow', 'text-shadow', 'filter'].includes(name)) return;
    if (/:focus/.test(rule.selector)) return;
    const layers =
        name === 'filter'
            ? [...value.matchAll(/drop-shadow\(([^)]*(?:\([^)]*\)[^)]*)*)\)/g)].map((match) => match[1])
            : split(resolveShadow(value), ',');
    for (const layer of layers) {
        const shadow = shadowOf(layer);
        if (!shadow || shadow.x || shadow.y || !shadow.blur || shadow.colour === null) continue;
        if (/var\(--deckit-focus\)/.test(shadow.colour) || isGrey(shadow.colour, false)) continue;
        tell('glow', at, `${name}: ${layer.trim()}`);
    }
}

function trackedCaps(declarations, tell) {
    const size = declarations.reduce((found, { name, value }) => {
        if (name === 'font-size') return sizeOf(value) ?? found;
        if (name === 'font') return sizeOfFont(value) ?? found;
        return found;
    }, null);
    // Text whose size the rule does not set is taken as the page's, under 16px but where a person reads and writes.
    if (size !== null && size >= 16) return;
    for (const { name, value, at } of declarations) {
        if (name === 'text-transform' && /\buppercase\b/.test(value))
            tell('tracked-caps', at, `text-transform: ${value}`);
        if (name !== 'letter-spacing') continue;
        const em = /^(-?[\d.]+)em$/.exec(value.trim());
        const px = /^(-?[\d.]+)px$/.exec(value.trim());
        const spacing = em ? Number(em[1]) : px ? Number(px[1]) / (size ?? TOKEN.type.body) : null;
        if (spacing !== null && spacing > 0.03) tell('tracked-caps', at, `letter-spacing: ${value}`);
    }
}

// The width of each side's border as the rule sets it, and the colour each side is drawn in, then whether a side,
// left or right, is 2px or more and wider than the rest, in a colour that is not grey. A shadow inset along one side
// alone draws one too, and so does a box 2 to 4px wide stretched along its row, filled in such a colour. A caret is
// drawn as one side, and is none.
function sideStripe(declarations, selector, tell) {
    if (/cursor|caret/i.test(selector)) return;
    const coloured = (colour) => !isClear(colour) && !isGrey(colour, false);
    const sides = { top: [0, ''], right: [0, ''], bottom: [0, ''], left: [0, ''] };
    const at = {};
    const SIDE = {
        'inline-start': 'left',
        'inline-end': 'right',
        top: 'top',
        right: 'right',
        bottom: 'bottom',
        left: 'left',
    };
    for (const { name, value, at: where } of declarations) {
        const match = /^border(?:-(top|right|bottom|left|inline-start|inline-end))?(-width|-color)?$/.exec(name);
        if (match) {
            const named = match[1] ? [SIDE[match[1]]] : Object.keys(sides);
            if (match[2] === '-width') {
                const widths = split(value, ' ').map(widthOf);
                const four = match[1] ? [widths[0]] : fourOf(widths);
                named.forEach((side, index) => (sides[side][0] = four[index] ?? 0));
            } else if (match[2] === '-color') named.forEach((side) => (sides[side][1] = value));
            else {
                const border = borderOf(value);
                named.forEach((side) => (sides[side] = [border.width, border.colour]));
            }
            named.forEach((side) => (at[side] = where));
        }
        if (name === 'box-shadow')
            for (const layer of split(resolveShadow(value), ',')) {
                const shadow = shadowOf(layer);
                if (
                    shadow?.inset &&
                    Math.abs(shadow.x) >= 2 &&
                    !shadow.y &&
                    !shadow.blur &&
                    !shadow.spread &&
                    coloured(shadow.colour)
                )
                    tell('side-stripe', where, `box-shadow: ${layer.trim()}`);
            }
    }
    for (const side of ['left', 'right']) {
        const [width, colour] = sides[side];
        const others = Object.entries(sides)
            .filter(([name]) => name !== side)
            .map(([, [each]]) => each);
        if (width >= 2 && width > Math.max(...others) && coloured(colour))
            tell('side-stripe', at[side], `border-${side} ${width}px, the other sides ${Math.max(...others)}px`);
    }
    const value = (name) =>
        declarations
            .filter((each) => each.name === name)
            .at(-1)
            ?.value.trim();
    const narrow = /^([\d.]+)px$/.exec(value('width') ?? '');
    const stretched =
        value('align-self') === 'stretch' ||
        value('height') === '100%' ||
        (value('top') !== undefined && value('bottom') !== undefined) ||
        /^0(?:px)?$/.test(value('inset') ?? '');
    const fill = declarations.filter(({ name }) => name === 'background' || name === 'background-color').at(-1);
    if (narrow && Number(narrow[1]) >= 2 && Number(narrow[1]) <= 4 && stretched && fill && coloured(fill.value))
        tell('side-stripe', fill.at, `a box ${narrow[1]}px wide along its row, filled ${fill.value}`);
}

function edgeAndElevation(declarations, tell) {
    const border = declarations.filter(({ name }) => name === 'border').at(-1);
    const shadow = declarations.filter(({ name }) => name === 'box-shadow').at(-1);
    if (!border || !shadow) return;
    const edge = borderOf(border.value);
    if (edge.width !== 1 || isClear(edge.colour)) return;
    const blur = Math.max(
        0,
        ...split(resolveShadow(shadow.value), ',')
            .map(shadowOf)
            .filter((each) => each && !each.inset)
            .map(({ blur: each }) => each)
    );
    if (blur >= 12) tell('edge-and-elevation', shadow.at, `border: ${border.value} with box-shadow blurred ${blur}px`);
}

// MARK: - Values

// Text split at `by` where it is not inside brackets.
function split(text, by) {
    const parts = [];
    let depth = 0;
    let start = 0;
    for (let at = 0; at < text.length; at++) {
        const character = text[at];
        if (character === '(') depth++;
        else if (character === ')') depth--;
        else if (!depth && (by === ' ' ? /\s/.test(character) : character === by)) {
            parts.push(text.slice(start, at));
            start = at + 1;
        }
    }
    parts.push(text.slice(start));
    return parts.filter((part) => part.trim());
}

// A size in px, read from px or the type scale, or null.
function sizeOf(value) {
    const px = /^(-?[\d.]+)px$/.exec(value.trim());
    if (px) return Number(px[1]);
    const type = /^var\(--deckit-type-(\w+)\)$/.exec(value.trim());
    if (type) return TOKEN.type[type[1]] ?? null;
    if (/^var\(--deckit-text-size\)$/.test(value.trim())) return 14;
    return null;
}

// What comes before the size in the `font` shorthand: its style, variant and weight.
function leadOfFont(value) {
    const parts = split(value.trim(), ' ');
    const size = parts.findIndex((part) => /^(?:[\d.]+(?:px|em|rem|%)|var\(|[a-z-]*-size\b)/.test(part));
    return size < 0 ? [] : parts.slice(0, size);
}

// The size the `font` shorthand gives, in px, or null.
function sizeOfFont(value) {
    const type = /^var\(--deckit-type-(\w+)\)$/.exec(value.trim());
    if (type) return TOKEN.type[type[1]] ?? null;
    const px = /(?:^|\s)(\d+(?:\.\d+)?)px(?:\/|\s|$)/.exec(value);
    return px ? Number(px[1]) : null;
}

function widthOf(value) {
    const text = value.trim();
    if (/^var\(--deckit-border\)$/.test(text)) return 1;
    const px = /^(\d+(?:\.\d+)?)px$/.exec(text);
    if (px) return Number(px[1]);
    return { thin: 1, medium: 3, thick: 5, 0: 0, none: 0 }[text] ?? 0;
}

function fourOf([top = 0, right = top, bottom = top, left = right]) {
    return [top, right, bottom, left];
}

// A border shorthand: its width in px and its colour, `var(--deckit-border)` the token's own 1px line.
function borderOf(value) {
    if (/^var\(--deckit-border\)$/.test(value.trim())) return { width: 1, colour: 'var(--deckit-border)' };
    const parts = split(value, ' ');
    if (parts.some((part) => /^(?:none|hidden|0)$/.test(part))) return { width: 0, colour: '' };
    const width = parts.find((part) => /^(?:[\d.]+px|thin|medium|thick)$/.test(part));
    const colour = parts
        .filter((part) => !/^(?:[\d.]+px|thin|medium|thick|solid|dashed|dotted|double)$/.test(part))
        .join(' ');
    return { width: width ? widthOf(width) : 3, colour };
}

// A shadow named by the token stands as its value.
function resolveShadow(value) {
    return value.replace(/var\(--deckit-shadow-([\w-]+)\)/g, (whole, name) => TOKEN.shadows[name] ?? whole);
}

// One layer of a shadow: `{ inset, x, y, blur, spread, colour }`, or null when its lengths cannot be read.
function shadowOf(layer) {
    const parts = split(layer.trim(), ' ');
    const inset = parts.includes('inset');
    const lengths = [];
    const rest = [];
    for (const part of parts) {
        if (part === 'inset') continue;
        const length = /^(-?[\d.]+)(?:px)?$/.exec(part);
        if (length && rest.length === 0) lengths.push(Number(length[1]));
        else rest.push(part);
    }
    if (lengths.length < 2 || rest.some((part) => /_/.test(part))) return null;
    const [x, y, blur = 0, spread = 0] = lengths;
    return { inset, x, y, blur, spread, colour: rest.join(' ') || 'currentColor' };
}

function isClear(colour) {
    return /^(?:transparent|)$/.test(colour.trim()) || /,\s*0\)$/.test(colour.trim());
}

// Whether a colour is a grey: one of the token's greys, one whose channels are alike, or both of a `light-dark()`.
// A colour that cannot be read, a property of a mod's own, is `unknown`.
function isGrey(colour, unknown = true) {
    const text = colour.trim().toLowerCase();
    if (!text || /^currentcolor$/.test(text)) return true;
    const both = /^light-dark\((.*)\)$/.exec(text);
    if (both) return split(both[1], ',').every((each) => isGrey(each, unknown));
    const token = /^var\(--deckit-([\w-]+)\)$/.exec(text);
    if (token) return TOKEN.colours[token[1]] ?? unknown;
    if (NAMED_COLOURS.has(text)) return GREY_NAMES.test(text);
    if (!/^(?:#|rgba?\(|hsla?\()/.test(text)) return unknown;
    return greyOf(text);
}

function greyOf(literal) {
    const text = literal.trim().toLowerCase();
    let channels = null;
    const hex = /^#([0-9a-f]{3,8})$/.exec(text);
    if (hex) {
        const digits = hex[1].length <= 4 ? [...hex[1]].map((digit) => digit + digit) : hex[1].match(/../g);
        channels = digits.slice(0, 3).map((pair) => parseInt(pair, 16));
    }
    const rgb = /^rgba?\(\s*([\d.]+)[\s,]+([\d.]+)[\s,]+([\d.]+)/.exec(text);
    if (rgb) channels = rgb.slice(1, 4).map(Number);
    const hsl = /^hsla?\(\s*[\d.]+(?:deg)?[\s,]+([\d.]+)%/.exec(text);
    if (hsl) return Number(hsl[1]) <= 5;
    if (!channels) return true;
    return Math.max(...channels) - Math.min(...channels) <= 12;
}

function kebab(name) {
    return name
        .replace(/^(Webkit|Moz|ms)(?=[A-Z])/, '-$1')
        .replace(/[A-Z]/g, (letter) => '-' + letter.toLowerCase())
        .toLowerCase();
}
