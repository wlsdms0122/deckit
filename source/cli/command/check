#!/usr/bin/env node
// Holds the packages' files to how they reach each other. Exits 1 with a line for each problem.
const fs = require('fs');
const path = require('path');

const LIBRARY = require(path.join(__dirname, '..', 'library.js'));

// What carries deck's messages over Electron's IPC, the only files that reach it.
const IPC = ['deckit-electron/messages/main.js', 'deckit-electron/messages/renderer.js'];
// The packages each may depend on. A driver stands on the shell, which declares what they agree on, and the shell knows
// no driver.
const MAY_DEPEND = {
    'deckit-electron': ['deckit-shell'],
    'deckit-shell': [],
};
// The shell reaches a driver only through what it is handed, so nothing of Electron's is in it: no module, nothing its
// bundles carry, and no Electron object it would hold or call.
const SHELL = 'deckit-shell';
const SHELL_BUNDLES = ['shell-main', 'shell-renderer'];
// The shell's files a driver's bundles carry as well as the shell's: each bundle has its own copy, so they are plain
// declarations and pure functions, which run on any side of any driver.
const SHARED = sharedFiles();
const ELECTRON = /\brequire\(\s*["'`]electron["'`]\s*\)/;
// Electron's objects and their members. `View` and `screen` are a page's words too (`window.screen`), so they are held
// only in what the shell's main bundle carries.
const ELECTRON_MEMBERS =
    'webContents|setBounds|setVisible|addChildView|removeChildView|setBackgroundColor|getBounds|isDestroyed|setWindowOpenHandler|setBackgroundThrottling';
const ELECTRON_NAMES = new RegExp(
    `\\b(?:WebContentsView|BrowserWindow|nativeTheme|ipcMain|ipcRenderer)\\b|\\.(?:${ELECTRON_MEMBERS})\\b|[{,]\\s*(?:${ELECTRON_MEMBERS})\\s*[,}:]`
);
// One read in brackets, with its name as a string.
const ELECTRON_READ = new RegExp(`\\[\\s*["'\`](?:${ELECTRON_MEMBERS})["'\`]\\s*\\]`);
const ELECTRON_MAIN_NAMES = /\b(?:View|screen)\b/;
// What runs code or reaches a process around what the shell is handed.
const AROUND = /\b(?:require|process|globalThis|eval|module)\b|\bFunction\s*\(/;
// A channel's declaration, whatever the module that declares it is imported as.
const DECLARES = '\\b\\w+\\.(?:pageToMain|mainToPage)\\(';
// What a package's root holds beside its concept folders: what puts it together in main and in a renderer, and its
// package.json, which says its entries and what it depends on.
const ROOT_FILES = ['main.js', 'renderer.js', 'package.json'];
// The files the shell's main bundle carries.
const SHELL_MAIN = LIBRARY.reach(LIBRARY.BUNDLES['shell-main'].entry);
const SURFACES = new Map(LIBRARY.PACKAGES.map((name) => [name, LIBRARY.surfaceOf(name)]));
// Where each bundle runs: main or a renderer.
const PLACES = {
    main: 'main',
    'shell-main': 'main',
    renderer: 'renderer',
    'shell-renderer': 'renderer',
};
const NODE_MODULES = [
    'fs',
    'fs/promises',
    'path',
    'os',
    'child_process',
    'net',
    'crypto',
    'util',
    'url',
    'worker_threads',
];
const NODE = new RegExp(`\\brequire\\(\\s*["'](?:node:)?(${NODE_MODULES.join('|')})["']\\s*\\)`);

const problems = [];
const channels = new Map(); // channel -> the protocol that declares it
const files = LIBRARY.files();
const imports = new Map(files.map((file) => [file, LIBRARY.importsOf(file)]));

// A package depends only on those it may (MAY_DEPEND).
for (const [name, { depends }] of SURFACES)
    for (const other of depends)
        if (!(MAY_DEPEND[name] || []).includes(other))
            problems.push(`deckit/${name}/package.json: depends on ${other}, which ${name} may not depend on`);
for (const [name, { entries }] of SURFACES)
    for (const entry of entries)
        if (!files.includes(entry))
            problems.push(`deckit/${name}/package.json: names the entry ${entry}, which is no script`);
for (const file of files) checkFile(file);
checkCycles();
checkPlaces();
checkFolders();

if (problems.length) {
    for (const line of problems) console.error(line);
    console.error(`${problems.length} problem${problems.length === 1 ? '' : 's'}`);
    process.exit(1);
}
console.log(`ok: ${files.length} modules, each in its package, importing what it uses`);

function say(file, what) {
    problems.push(`deckit/${file}: ${what}`);
}

function packageOf(file) {
    return file.split('/')[0];
}

// The module a file is of: its folder, where model/ is its folder's.
function moduleOf(file) {
    return path.posix.dirname(file).replace(/\/model$/, '');
}

function checkFile(file) {
    const plain = LIBRARY.code(fs.readFileSync(path.join(LIBRARY.DECKIT, file), 'utf8'));
    if (/\bDeckit[A-Z]\w*\b/.test(plain)) say(file, 'reaches a Deckit global; import what it uses');
    // Every file reaches another by a static import, which the bundler follows and this check reads.
    if (/\brequire\(\s*["'`]\./.test(plain))
        say(file, 'requires a file; import it, so the check and the bundle see it');
    for (const [, spec] of plain.matchAll(/\brequire\(\s*["'`]([^"'`.][^"'`]*)["'`]\s*\)/g))
        if (spec !== 'electron' && !NODE_MODULES.includes(spec.replace(/^node:/, '')))
            say(file, `requires ${spec}, a package of npm: a package requires only Electron and Node`);
    if (/\bimport\s*\(/.test(plain))
        say(file, 'imports while it runs; import statically, so the check and the bundle see it');
    if (!IPC.includes(file) && /\bipc(Main|Renderer)\b/.test(plain))
        say(file, `reaches Electron's IPC; say what crosses in a protocol.js`);
    if (SHARED.has(file)) checkPure(file, plain);
    if (packageOf(file) === SHELL) checkShell(file, plain);
    const protocol = file.endsWith('/protocol.js');
    if (!protocol && /["'`](deckit-electron|deckit-shell):(?!\/\/)/.test(plain))
        say(file, 'writes a channel; channels are declared in a protocol.js');
    if (protocol) checkChannels(file, plain);
    for (const { spec, file: target } of imports.get(file)) checkImport(file, spec, target);
}

// What a driver's bundles and the shell's both carry holds nothing of either: no module, nothing of a process or a
// page, and no state of its own. Read without its strings, so a channel's name or a word in one is not taken for a use.
function checkPure(file, plain) {
    const bare = LIBRARY.bare(plain);
    const shared = 'both a driver and the shell carry it';
    if (/\brequire\s*\(/.test(bare)) say(file, `requires a module, but ${shared}: it is plain declarations`);
    if (/\b(?:globalThis|window|document|process|self)\s*[.[]/.test(bare))
        say(file, `reaches a process or a page, but ${shared}: it runs on any side of any driver`);
    if (/^(?:let|var)\b/m.test(bare) || /^\S[^\n]*\bnew\s+(?:Map|Set|WeakMap|WeakSet)\s*\(/m.test(bare))
        say(file, `holds state, but ${shared}: it is plain declarations and pure functions`);
}

// The shell's code, read without its strings: nothing it requires, and no Electron object's name or member.
function checkShell(file, plain) {
    const bare = LIBRARY.bare(plain);
    const around = bare.match(AROUND);
    if (around) say(file, `uses ${around[0]}, but ${SHELL}/ reaches a driver only through what it is handed`);
    const named =
        bare.match(ELECTRON_NAMES) || plain.match(ELECTRON_READ) || (SHELL_MAIN.has(file) && bare.match(ELECTRON_MAIN_NAMES));
    if (named)
        say(file, `names ${named[0].trim()} of Electron's, but ${SHELL}/ reaches a driver only through what it is handed`);
}

// The shell's files carried both by a bundle of the shell's and by one of a driver's.
function sharedFiles() {
    const reached = (names) => new Set(names.flatMap((name) => [...LIBRARY.reach(LIBRARY.BUNDLES[name].entry)]));
    const shell = reached(SHELL_BUNDLES);
    const driver = reached(Object.keys(LIBRARY.BUNDLES).filter((name) => !SHELL_BUNDLES.includes(name)));
    return new Set([...shell].filter((file) => packageOf(file) === SHELL && driver.has(file)));
}

// A package's channels are its own: each starts with its package's name, and one channel has one declaration, so no
// package reaches another's around what that one answers.
function checkChannels(file, plain) {
    const owner = packageOf(file);
    if (new RegExp(DECLARES + `\\s*(?=\\S)(?!["'\`][^"'\`$]*["'\`])`).test(plain))
        say(file, 'declares a channel not written out as text, so whose it is cannot be read');
    for (const [, channel] of plain.matchAll(new RegExp(DECLARES + `\\s*["'\`]([^"'\`]+)["'\`]`, 'g'))) {
        if (!channel.startsWith(owner + ':')) say(file, `declares the channel ${channel}, which is not ${owner}'s`);
        if (channels.has(channel))
            say(file, `declares the channel ${channel}, which ${channels.get(channel)} declares`);
        channels.set(channel, file);
    }
}

function checkImport(file, spec, target) {
    if (!target) return say(file, `imports ${spec}, a package of npm: a package imports only files`);
    const full = path.join(LIBRARY.DECKIT, target);
    if (!fs.existsSync(full) || !fs.statSync(full).isFile())
        return say(file, `imports ${spec}, which is no file of the packages`);
    const mine = packageOf(file);
    const theirs = packageOf(target);
    if (!SURFACES.has(theirs)) return say(file, `imports ${target}, which is in no package`);
    if (theirs !== mine) {
        if (!SURFACES.get(mine).depends.has(theirs))
            say(file, `imports ${target}, in ${theirs}/, which ${mine}/ does not depend on`);
        else if (!SURFACES.get(theirs).entries.has(target))
            say(file, `imports ${target}, which is not an entry of ${theirs}/`);
        return;
    }
    // Inside a package, a folder is a module: it uses its own folders and the folders beside it, with theirs, and
    // never its parent or anything above it.
    const from = moduleOf(file);
    const to = moduleOf(target);
    const parent = path.posix.dirname(from);
    if (from.startsWith(to + '/')) say(file, `imports ${target}, in ${to}/, which holds it`);
    else if (to !== from && !to.startsWith(from + '/') && !to.startsWith(parent + '/'))
        say(file, `imports ${target}, outside ${parent}/`);
    // A concept's channels are how its own sides reach each other.
    if (target.endsWith('/protocol.js') && moduleOf(target) !== moduleOf(file))
        say(file, `imports ${target}, how ${moduleOf(target)} is reached, which is ${moduleOf(target)}'s own`);
}

function checkCycles() {
    const state = new Map();
    const visit = (file, trail) => {
        if (state.get(file) === 'done' || !imports.has(file)) return;
        if (state.get(file) === 'visiting')
            return say(file, `imports itself through ${trail.slice(trail.indexOf(file) + 1).join(' -> ')}`);
        state.set(file, 'visiting');
        for (const { file: target } of imports.get(file)) if (target) visit(target, [...trail, file]);
        state.set(file, 'done');
    };
    for (const file of files) visit(file, []);
}

// Each bundle carries its entry and what that imports, and runs where its place says: main.js never in a renderer,
// renderer.js never in main, and nothing a renderer carries requires Node. Every file is in a bundle.
function checkPlaces() {
    const carried = new Set();
    for (const [name, { entry }] of Object.entries(LIBRARY.BUNDLES)) {
        const place = PLACES[name];
        for (const file of LIBRARY.reach(entry)) {
            carried.add(file);
            const plain = LIBRARY.code(fs.readFileSync(path.join(LIBRARY.DECKIT, file), 'utf8'));
            if (place !== 'main' && /(^|\/)main\.js$/.test(file))
                say(file, `runs in main, but the ${name} bundle carries it`);
            if (place !== 'renderer' && /(^|\/)renderer\.js$/.test(file))
                say(file, `runs in a renderer, but the ${name} bundle carries it`);
            if (SHELL_BUNDLES.includes(name) && ELECTRON.test(plain))
                say(file, `requires Electron, but the ${name} bundle carries it`);
            if (place !== 'main' && NODE.test(plain))
                say(file, `requires a Node module, but the ${name} bundle carries it`);
        }
    }
    for (const file of files)
        if (!carried.has(file)) say(file, 'is in no bundle: nothing a bundle starts from imports it');
}

// A folder is a module (its files, and model/ for what supports them) or a group (folders only). A package's root
// is a group that also holds its package.json and what puts the package together on each side: main.js and renderer.js.
function checkFolders() {
    const walk = (folder) => {
        const entries = fs
            .readdirSync(path.join(LIBRARY.DECKIT, folder), { withFileTypes: true })
            .filter(({ name }) => name !== '.DS_Store');
        const folders = entries.filter((entry) => entry.isDirectory()).map(({ name }) => name);
        const below = folders.filter((name) => name !== 'model');
        const root = LIBRARY.PACKAGES.includes(folder);
        const held = entries.filter((entry) => entry.isFile() && !(root && ROOT_FILES.includes(entry.name)));
        for (const { name } of held)
            if (!name.endsWith('.js')) say(`${folder}/${name}`, 'is not a script: a package holds ES modules (.js)');
        if (root && held.length) {
            say(
                folder,
                `holds ${held.map(({ name }) => name).join(', ')}: a package's root holds only ${ROOT_FILES.join(', ')}, and its concepts are folders`
            );
        } else if (held.length && below.length) {
            say(
                folder,
                `holds files and the folders ${below.join(', ')}: a folder is a module (files, and model/) or a group (folders only)`
            );
        } else if ((root || !held.length) && folders.includes('model')) {
            say(folder, 'holds model/ and no files of its own: a group holds folders only');
        }
        for (const name of folders) walk(`${folder}/${name}`);
    };
    for (const name of LIBRARY.PACKAGES) walk(name);
}
