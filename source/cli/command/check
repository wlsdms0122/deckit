#!/usr/bin/env node
// Holds the libraries' files to how they reach each other. Exits 1 with a line for each problem.
const fs = require('fs');
const path = require('path');

const LIBRARY = require(path.join(__dirname, '..', 'library.js'));
const { conceptOf } = require(path.join(__dirname, '..', 'concept.js'));

const IPC = 'core/ipc';
// The entries a host app starts.
const ENTRIES = new Set(['deckit/main', 'deckit/page', 'shell/main', 'shell/page']);
// A unit's root files put its main or its page together, and so may name any of its concepts' protocols.
const ROOTS = new Set(['deck/main', 'deck/page', ...ENTRIES]);
// What a host app hands deckit, which it may not: named as optional.
const HOST_INPUTS = new Set(['host/config', 'host/folders', 'host/exports']);
// Core names nothing of deckit. Deck names nothing of deckit, and deckit nothing of the shell. The shell reaches
// deckit through what connect answers, so of the units under it it names only core.
const MAY_NAME = {
    core: new Set(['core']),
    deck: new Set(['core', 'deck']),
    deckit: new Set(['core', 'deck', 'deckit']),
    shell: new Set(['core', 'shell']),
};
const RUNS = new Set(['main', 'page', 'node', 'electron', 'any']);
const FITS = {
    page: ['page', 'electron', 'any'],
    main: ['main', 'node', 'electron', 'any'],
    chord: ['any'],
    'shell-page': ['page', 'electron', 'any'],
    'shell-main': ['main', 'node', 'electron', 'any'],
};
const NODE =
    /\brequire\(\s*["'](?:node:)?(fs|fs\/promises|path|os|child_process|net|crypto|util|worker_threads)["']\s*\)/;
const ELECTRON = /\brequire\(\s*["']electron["']\s*\)/;

const problems = [];
const channels = new Map(); // channel -> the protocol that declares it
const all = new Map(); // module name -> { file, uses, provides, runs, plain }

for (const file of LIBRARY.files()) {
    if (file === LIBRARY.REGISTRY) continue;
    const declared = LIBRARY.moduleOf(file);
    if (declared.problem) {
        say(file, declared.problem);
        continue;
    }
    checkFile(file, declared);
    all.set(declared.name, { file, ...declared });
}
for (const [name, module] of all) checkUses(name, module);
checkCycles();
checkBundles();
checkFolders();
checkPlaces();
checkOutside();

if (problems.length) {
    for (const line of problems) console.error(line);
    console.error(`${problems.length} problem${problems.length === 1 ? '' : 's'}`);
    process.exit(1);
}
console.log(`ok: ${all.size} modules, each in its unit, naming what it uses`);

function say(file, what) {
    problems.push(`deckit/${file}: ${what}`);
}

function checkFile(file, { name, provides, plain, uses }) {
    if (name !== LIBRARY.nameOf(file)) say(file, `defines "${name}", but its name is "${LIBRARY.nameOf(file)}"`);
    if (all.has(name)) say(file, `defines ${name}, which ${all.get(name).file} defines too`);
    if (!provides.length)
        say(file, 'provides nothing: a module that starts something provides start, and whoever starts it calls it');
    for (const bad of provides.filter(
        (name, index) => !/^[A-Za-z_$][\w$]*$/.test(name) || provides.indexOf(name) !== index
    )) {
        say(file, `provides "${bad}", which is not a name, or is there twice`);
    }
    if (/\bDeckitModule\.(?!define\b)\w+/.test(plain))
        say(file, 'calls the registry for something other than define(); name what it uses in its define()');
    for (const [, global] of plain.matchAll(/\b(Deckit[A-Z]\w*)\b/g)) {
        if (global !== 'DeckitModule') say(file, `reaches the global ${global}; name what it uses in its define()`);
    }
    if (name !== IPC && /\bipc(Main|Renderer)\b/.test(plain))
        say(file, `reaches Electron's IPC; say what crosses in a protocol.js`);
    const protocol = file.endsWith('/protocol.js');
    if (!protocol && /["'`](deck|deckit|shell):(?!\/\/)/.test(plain))
        say(file, 'writes a channel; channels are declared in a protocol.js');
    if (protocol) checkChannels(file, plain);
    if (!protocol && uses.some((use) => use.name === IPC)) say(file, `names ${IPC}, which only a protocol names`);
}

// A library's channels are its own: each starts with its library's name, and one channel has one declaration, so no
// library reaches another's around what that one answers.
function checkChannels(file, plain) {
    const library = file.split('/')[0];
    if (/\bIPC\.(?:rendererToMain|mainToRenderer)\(\s*(?=\S)(?!["'`][^"'`$]*["'`])/.test(plain))
        say(file, 'declares a channel not written out as text, so whose it is cannot be read');
    for (const [, channel] of plain.matchAll(/\bIPC\.(?:rendererToMain|mainToRenderer)\(\s*["'`]([^"'`]+)["'`]/g)) {
        if (!channel.startsWith(library + ':')) say(file, `declares the channel ${channel}, which is not ${library}'s`);
        if (channels.has(channel))
            say(file, `declares the channel ${channel}, which ${channels.get(channel)} declares`);
        channels.set(channel, file);
    }
}

function checkUses(name, { file, uses }) {
    const mine = conceptOf(file);
    if (!mine)
        return say(
            file,
            'is in no unit: a file is in core/, deck/, deckit/ or shell/'
        );
    for (const use of uses) {
        if (HOST_INPUTS.has(use.name)) {
            if (!use.optional)
                say(
                    file,
                    `names ${use.name} as something it cannot do without; a host app may not hand it, so write "${use.name}?"`
                );
            continue;
        }
        const theirs = all.get(use.name);
        if (!theirs) {
            say(file, `names ${use.name}, which is neither deckit's nor something a host app hands it`);
            continue;
        }
        if (ENTRIES.has(use.name)) say(file, `names ${use.name}, an entry, which only a host app starts`);
        const other = conceptOf(theirs.file);
        if (!MAY_NAME[mine.layer].has(other.layer))
            say(file, `names ${use.name}, in ${other.layer}/, which ${mine.layer}/ does not name`);
        // A concept's channels are how its own sides reach each other.
        if (theirs.file.endsWith('/protocol.js') && other.concept !== mine.concept && !ROOTS.has(name)) {
            say(file, `names ${use.name}, how ${other.concept} is reached, which is ${other.concept}'s own`);
        }
    }
}

function checkCycles() {
    const state = new Map();
    const visit = (name, trail) => {
        if (state.get(name) === 'done' || !all.has(name)) return;
        if (state.get(name) === 'visiting')
            return say(all.get(name).file, `names itself through ${trail.slice(trail.indexOf(name) + 1).join(' -> ')}`);
        state.set(name, 'visiting');
        for (const use of all.get(name).uses) visit(use.name, [...trail, name]);
        state.set(name, 'done');
    };
    for (const name of all.keys()) visit(name, []);
}

// Where a file runs follows from its name where its name says it (main.js, page.js, the kit); anywhere else its
// define declares it. Each bundle carries only what runs where it does.
function checkBundles() {
    const bundles = LIBRARY.bundles();
    const bundled = new Set(Object.values(bundles).flat());
    const placeOf = new Map();
    for (const { file, runs } of all.values()) {
        if (!bundled.has(file)) say(file, 'is in no bundle: nothing a bundle starts from names it');
        const named = /(^|\/)main\.js$/.test(file)
            ? 'main'
            : /(^|\/)page\.js$/.test(file) || file.startsWith('shell/ui/')
              ? 'page'
              : null;
        if (runs && !RUNS.has(runs)) say(file, `runs "${runs}", which is none of ${[...RUNS].join(', ')}`);
        else if (named && runs && runs !== named)
            say(file, `is named for ${named === 'main' ? 'main' : 'a page'}, but declares it runs "${runs}"`);
        else if (!named && !runs)
            say(
                file,
                `says nowhere where it runs: its name does not, so its define declares it (runs: ${[...RUNS].join(' | ')})`
            );
        placeOf.set(file, named || runs);
    }
    for (const [bundle, fits] of Object.entries(FITS)) {
        for (const file of bundles[bundle]) {
            if (!fits.includes(placeOf.get(file)))
                say(
                    file,
                    `runs "${placeOf.get(file)}", but the ${bundle} bundle carries it: something it starts from names it`
                );
        }
    }
    for (const { file, plain } of all.values()) {
        const runs = placeOf.get(file);
        if ((runs === 'page' || runs === 'any') && NODE.test(plain))
            say(file, `runs "${runs}", but requires a Node module`);
        if ((runs === 'node' || runs === 'any') && ELECTRON.test(plain))
            say(file, `runs "${runs}", but requires Electron`);
    }
}

// A folder is a module (its files, and model/ for what supports them) or a group (folders only).
function checkFolders() {
    const walk = (folder) => {
        const entries = fs
            .readdirSync(path.join(LIBRARY.DECKIT, folder), { withFileTypes: true })
            .filter(({ name }) => !name.startsWith('.'));
        const files = entries.filter((entry) => entry.isFile());
        const folders = entries.filter((entry) => entry.isDirectory()).map(({ name }) => name);
        const below = folders.filter((name) => name !== 'model');
        // A unit's root holds its root files beside its concepts; core is a group.
        const unitRoot = LIBRARY.LIBRARIES.includes(folder) && folder !== 'core';
        if (!unitRoot && files.length && below.length) {
            say(
                folder,
                `holds files and the folders ${below.join(', ')}: a folder is a module (files, and model/) or a group (folders only)`
            );
        }
        for (const name of folders) walk(`${folder}/${name}`);
    };
    for (const library of LIBRARY.LIBRARIES) walk(library);
}

// Every file of a library is reachable by its path: a file outside the layers is no module's.
function checkPlaces() {
    for (const { file } of all.values()) if (!conceptOf(file)) say(file, 'is in no layer');
}

function checkOutside() {
    const walk = (folder) =>
        fs.readdirSync(folder, { withFileTypes: true }).flatMap((entry) => {
            const full = path.join(folder, entry.name);
            if (entry.isDirectory()) return walk(full);
            return entry.name.endsWith('.js') ? [full] : [];
        });
    for (const file of walk(LIBRARY.DECKIT)) {
        const plain = LIBRARY.code(fs.readFileSync(file, 'utf8'));
        for (const [, wanted] of plain.matchAll(/require\(\s*["'](\.{1,2}\/[^"']+)["']\s*\)/g)) {
            const to = path.resolve(path.dirname(file), wanted);
            if (!to.startsWith(LIBRARY.DECKIT + path.sep))
                problems.push(
                    `${path.relative(LIBRARY.DECKIT, file)}: requires ${wanted}, which is outside source/deckit/`
                );
        }
    }
}
