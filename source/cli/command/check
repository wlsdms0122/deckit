#!/usr/bin/env node
// Holds the libraries' files to how they reach each other. Exits 1 with a line for each problem.
const fs = require('fs');
const path = require('path');

const LIBRARY = require(path.join(__dirname, '..', 'library.js'));

const IPC = 'core/ipc/index.js';
// Core names nothing of deckit. Deck names nothing of deckit, and deckit nothing of the shell. The shell reaches
// deckit through what connect answers, so of the units under it it names only core.
const MAY_NAME = {
    core: new Set(['core']),
    deck: new Set(['core', 'deck']),
    deckit: new Set(['core', 'deck', 'deckit']),
    shell: new Set(['core', 'shell']),
};
// Where each bundle runs: main, a page, or anywhere (the chord, for a page of the host app's).
const PLACES = { main: 'main', 'shell-main': 'main', page: 'page', 'shell-page': 'page', chord: 'anywhere' };
const NODE =
    /\brequire\(\s*["'](?:node:)?(fs|fs\/promises|path|os|child_process|net|crypto|util|url|worker_threads)["']\s*\)/;
const ELECTRON = /\brequire\(\s*["']electron["']\s*\)/;

const problems = [];
const channels = new Map(); // channel -> the protocol that declares it
const files = LIBRARY.files();
const imports = new Map(files.map((file) => [file, LIBRARY.importsOf(file)]));

for (const file of files) checkFile(file);
checkCycles();
checkPlaces();
checkFolders();

if (problems.length) {
    for (const line of problems) console.error(line);
    console.error(`${problems.length} problem${problems.length === 1 ? '' : 's'}`);
    process.exit(1);
}
console.log(`ok: ${files.length} modules, each in its unit, importing what it uses`);

function say(file, what) {
    problems.push(`deckit/${file}: ${what}`);
}

function unitOf(file) {
    return file.split('/')[0];
}

// A unit's root files (deck/main.js, deckit/page.js) are what the other units import of it, and put its main or its
// page together.
function isRoot(file) {
    return file.split('/').length === 2;
}

function conceptOf(file) {
    return path.posix.dirname(file).replace(/\/model$/, '');
}

function checkFile(file) {
    const plain = LIBRARY.code(fs.readFileSync(path.join(LIBRARY.DECKIT, file), 'utf8'));
    if (!MAY_NAME[unitOf(file)]) return say(file, 'is in no unit: a file is in core/, deck/, deckit/ or shell/');
    if (/\bDeckit[A-Z]\w*\b/.test(plain)) say(file, 'reaches a Deckit global; import what it uses');
    if (file !== IPC && /\bipc(Main|Renderer)\b/.test(plain))
        say(file, `reaches Electron's IPC; say what crosses in a protocol.js`);
    const protocol = file.endsWith('/protocol.js');
    if (!protocol && /["'`](deck|deckit|shell):(?!\/\/)/.test(plain))
        say(file, 'writes a channel; channels are declared in a protocol.js');
    if (protocol) checkChannels(file, plain);
    for (const { spec, file: target } of imports.get(file)) checkImport(file, spec, target);
}

// A unit's channels are its own: each starts with its unit's name, and one channel has one declaration, so no unit
// reaches another's around what that one answers.
function checkChannels(file, plain) {
    const unit = unitOf(file);
    if (/\bIPC\.(?:rendererToMain|mainToRenderer)\(\s*(?=\S)(?!["'`][^"'`$]*["'`])/.test(plain))
        say(file, 'declares a channel not written out as text, so whose it is cannot be read');
    for (const [, channel] of plain.matchAll(/\bIPC\.(?:rendererToMain|mainToRenderer)\(\s*["'`]([^"'`]+)["'`]/g)) {
        if (!channel.startsWith(unit + ':')) say(file, `declares the channel ${channel}, which is not ${unit}'s`);
        if (channels.has(channel))
            say(file, `declares the channel ${channel}, which ${channels.get(channel)} declares`);
        channels.set(channel, file);
    }
}

function checkImport(file, spec, target) {
    if (!target) return say(file, `imports ${spec}, a package: a library imports only its own files`);
    if (!fs.existsSync(path.join(LIBRARY.DECKIT, target)))
        return say(file, `imports ${spec}, which is no file of the libraries`);
    const mine = unitOf(file);
    const theirs = unitOf(target);
    if (!MAY_NAME[theirs]) return say(file, `imports ${target}, which is in no unit`);
    if (!MAY_NAME[mine].has(theirs)) say(file, `imports ${target}, in ${theirs}/, which ${mine}/ does not name`);
    // A unit is one module: another reaches it by its root files. Core is a group, each module of it its own.
    if (theirs !== mine && theirs !== 'core' && !isRoot(target))
        say(file, `imports ${target}, inside ${theirs}/: another unit reaches it by its root files`);
    // A concept's channels are how its own sides reach each other, and its unit's root puts them together.
    const own = conceptOf(target) === conceptOf(file) || (isRoot(file) && theirs === mine);
    if (target.endsWith('/protocol.js') && !own)
        say(file, `imports ${target}, how ${conceptOf(target)} is reached, which is ${conceptOf(target)}'s own`);
}

function checkCycles() {
    const state = new Map();
    const visit = (file, trail) => {
        if (state.get(file) === 'done' || !imports.has(file)) return;
        if (state.get(file) === 'visiting')
            return say(file, `imports itself through ${trail.slice(trail.indexOf(file) + 1).join(' -> ')}`);
        state.set(file, 'visiting');
        for (const { file: target } of imports.get(file)) if (target) visit(target, [...trail, file]);
        state.set(file, 'done');
    };
    for (const file of files) visit(file, []);
}

// Each bundle carries its entry and what that imports, and runs where its place says: main.js never in a page,
// page.js never in main, and nothing a page or anywhere carries requires Node; what runs anywhere requires no
// Electron either. Every file is in a bundle.
function checkPlaces() {
    const carried = new Set();
    for (const [name, { entry }] of Object.entries(LIBRARY.BUNDLES)) {
        const place = PLACES[name];
        for (const file of LIBRARY.reach(entry)) {
            carried.add(file);
            const plain = LIBRARY.code(fs.readFileSync(path.join(LIBRARY.DECKIT, file), 'utf8'));
            if (place !== 'main' && /(^|\/)main\.js$/.test(file))
                say(file, `runs in main, but the ${name} bundle carries it`);
            if (place !== 'page' && /(^|\/)page\.js$/.test(file))
                say(file, `runs in a page, but the ${name} bundle carries it`);
            if (place !== 'main' && NODE.test(plain))
                say(file, `requires a Node module, but the ${name} bundle carries it`);
            if (place === 'anywhere' && ELECTRON.test(plain))
                say(file, `requires Electron, but the ${name} bundle carries it`);
        }
    }
    for (const file of files)
        if (!carried.has(file)) say(file, 'is in no bundle: nothing a bundle starts from imports it');
}

// A folder is a module (its files, and model/ for what supports them) or a group (folders only). A unit's root holds
// its root files beside its concepts; core is a group.
function checkFolders() {
    const walk = (folder) => {
        const entries = fs
            .readdirSync(path.join(LIBRARY.DECKIT, folder), { withFileTypes: true })
            .filter(({ name }) => !name.startsWith('.'));
        const held = entries.filter((entry) => entry.isFile());
        const folders = entries.filter((entry) => entry.isDirectory()).map(({ name }) => name);
        const below = folders.filter((name) => name !== 'model');
        const unitRoot = LIBRARY.UNITS.includes(folder) && folder !== 'core';
        if (!unitRoot && held.length && below.length) {
            say(
                folder,
                `holds files and the folders ${below.join(', ')}: a folder is a module (files, and model/) or a group (folders only)`
            );
        }
        for (const name of folders) walk(`${folder}/${name}`);
    };
    for (const unit of LIBRARY.UNITS) walk(unit);
}
