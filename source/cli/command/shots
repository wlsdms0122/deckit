#!/usr/bin/env -S node --no-warnings
// Draws every surface of Deckit.app reached without the real screen, in the light look and in the dark, into
// .build/shots/<light|dark>/<name>.png, so one design can be held beside another. The look is the app's own, its main
// process's `nativeTheme.themeSource`, set in memory: the machine's appearance is left as it is. Each look is a run of
// its own of Deckit.app, put together from the archive it builds first, with data of its own that is thrown away; the
// app's log is left beside the shots, .build/shots/<look>.log. Notifications' list is drawn from a record the run
// starts with, as its item in the status bar shows it; nothing is posted, so no notification reaches the system's. What the host
// window's material shows, the machine's screen behind it blurred, cannot be drawn into a shot, so every shot is laid
// over a stand-in for it: a wallpaper drawn from code, blurred as the material blurs (`wallpaper`). Exits 1 naming
// each surface not drawn.
const fs = require('fs');
const http = require('http');
const net = require('net');
const path = require('path');
const { pathToFileURL } = require('url');

const root = path.join(__dirname, '..', '..', '..');
const { execFileSync } = require('child_process');
const { start } = require(path.join(root, 'source', 'cli', 'test', 'start.js'));
const { seat } = require(path.join(root, 'source', 'cli', 'test', 'seat.js'));
const { until, sleep, ALT, CTRL, META } = require(path.join(root, 'source', 'cli', 'test', 'devtools.js'));
const { readKey, connect } = require(path.join(root, 'source', 'cli', 'outside', 'client.js'));
const OUT = path.join(root, '.build', 'shots');
const LOOKS = ['light', 'dark'];
const LIMIT = 600000;
// The folder the Editor comes back to, named the same in every run, its files, and the one it shows.
const FOLDER = 'sample';
const FILES = {
    'README.md': '# Sample\n\nA small project the Editor and the Finder show.\n',
    'source/main.js': "import { greet } from './greet.js';\n\nconsole.log(greet('Deckit'));\n",
    'source/greet.js': 'export function greet(name) {\n    return `Hello, ${name}`;\n}\n',
    'notes.txt': Array.from({ length: 30 }, (_, index) => `line ${index + 1}`).join('\n') + '\n',
};
const SHOWN = 'source/main.js';
// How far the material blurs what is behind it, and around the switcher's floating window, how much of what is behind
// it its shot shows and the radius the system cuts its corners to, in points.
const BLUR = 30;
const MARGIN = 48;
const CORNER = 16;

const args = process.argv.slice(2);
const port = args.length ? Number(args[1]) : 9336;
if ((args.length && (args.length !== 2 || args[0] !== '--port')) || !Number.isInteger(port) || port <= 0) {
    console.error(`usage: deckit shots [--port <the main process's inspector port, default 9336>]
Each shot is laid over a stand-in for what is behind the app's window: a wallpaper drawn from code, blurred.`);
    process.exit(2);
}

// The stand-in for the screen behind the host window, `width` by `height` points: a soft, colourful wallpaper,
// the same in every run, blurred `blur` points as the window's material blurs it, a PNG in base64 at the page's pixels.
// It runs in a page, from its source: it uses nothing outside it.
function wallpaper(width, height, blur) {
    const scale = devicePixelRatio;
    const margin = blur * 3;
    const sheet = document.createElement('canvas');
    sheet.width = Math.round((width + 2 * margin) * scale);
    sheet.height = Math.round((height + 2 * margin) * scale);
    const paint = sheet.getContext('2d');
    paint.scale(scale, scale);
    paint.translate(margin, margin);
    const base = paint.createLinearGradient(0, 0, width, height);
    base.addColorStop(0, '#3a5bd9');
    base.addColorStop(0.45, '#8a4fd0');
    base.addColorStop(1, '#f2785c');
    paint.fillStyle = base;
    paint.fillRect(-margin, -margin, width + 2 * margin, height + 2 * margin);
    const side = Math.max(width, height);
    // Glows, each at a share of the screen, its radius a share of its longer side, and its colour.
    for (const [x, y, radius, colour] of [
        [0.12, 0.18, 0.42, '#3fc8f2'],
        [0.82, 0.12, 0.36, '#ffb35c'],
        [0.58, 0.78, 0.46, '#ff5f9e'],
        [0.08, 0.92, 0.32, '#45dfa9'],
        [0.94, 0.88, 0.3, '#ffe36b'],
    ]) {
        const glow = paint.createRadialGradient(x * width, y * height, 0, x * width, y * height, radius * side);
        glow.addColorStop(0, colour);
        glow.addColorStop(1, colour + '00');
        paint.fillStyle = glow;
        paint.fillRect(-margin, -margin, width + 2 * margin, height + 2 * margin);
    }
    // Shapes with edges, for the blur to soften: two discs and a band across.
    paint.fillStyle = 'rgba(255, 255, 255, 0.28)';
    paint.beginPath();
    paint.arc(0.3 * width, 0.42 * height, 0.16 * side, 0, 2 * Math.PI);
    paint.fill();
    paint.fillStyle = 'rgba(20, 24, 80, 0.3)';
    paint.beginPath();
    paint.arc(0.72 * width, 0.5 * height, 0.11 * side, 0, 2 * Math.PI);
    paint.fill();
    paint.fillStyle = 'rgba(255, 240, 200, 0.22)';
    paint.beginPath();
    paint.moveTo(-margin, 0.62 * height);
    paint.bezierCurveTo(0.3 * width, 0.5 * height, 0.6 * width, 0.86 * height, width + margin, 0.66 * height);
    paint.lineTo(width + margin, 0.76 * height);
    paint.bezierCurveTo(0.6 * width, 0.96 * height, 0.3 * width, 0.6 * height, -margin, 0.72 * height);
    paint.fill();
    // Blurred at a quarter of the pixels, which the blur keeps from showing, by three box blurs across and down, which
    // come to a gaussian blur of deviation `blur`, as the material's.
    const quarter = document.createElement('canvas');
    quarter.width = Math.ceil(sheet.width / 4);
    quarter.height = Math.ceil(sheet.height / 4);
    const small = quarter.getContext('2d', { willReadFrequently: true });
    small.drawImage(sheet, 0, 0, quarter.width, quarter.height);
    const image = small.getImageData(0, 0, quarter.width, quarter.height);
    const radius = Math.round((blur * scale) / 4);
    const box = (lines, length, startOf, step) => {
        const line = new Float32Array(length);
        for (let at = 0; at < lines; at++)
            for (let channel = 0; channel < 3; channel++) {
                const start = startOf(at) + channel;
                for (let k = 0; k < length; k++) line[k] = image.data[start + k * step];
                const value = (k) => line[Math.min(length - 1, Math.max(0, k))];
                let sum = 0;
                for (let k = -radius; k <= radius; k++) sum += value(k);
                for (let k = 0; k < length; k++) {
                    image.data[start + k * step] = sum / (2 * radius + 1);
                    sum += value(k + radius + 1) - value(k - radius);
                }
            }
    };
    for (let pass = 0; pass < 3; pass++) {
        box(quarter.height, quarter.width, (row) => row * quarter.width * 4, 4);
        box(quarter.width, quarter.height, (column) => column * 4, quarter.width * 4);
    }
    small.putImageData(image, 0, 0);
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(width * scale);
    canvas.height = Math.round(height * scale);
    const context = canvas.getContext('2d');
    context.imageSmoothingQuality = 'high';
    context.drawImage(quarter, -margin * scale, -margin * scale, sheet.width, sheet.height);
    return canvas.toDataURL('image/png').split(',')[1];
}

// A site of the machine's own for the Browser's tabs: two pages, and a file it hands over to keep.
function site() {
    const pages = {
        '/': '<title>Example</title><h1>Example</h1><p>A page the Browser shows in front.</p>',
        '/behind': '<title>Behind</title><h1>Behind</h1><p>A page the Browser keeps asleep.</p>',
    };
    return http.createServer((request, response) => {
        if (request.url === '/report.csv') {
            response.writeHead(200, {
                'Content-Type': 'text/csv',
                'Content-Disposition': 'attachment; filename="report.csv"',
            });
            return response.end('a,b\n1,2\n');
        }
        response.writeHead(pages[request.url] ? 200 : 404, { 'Content-Type': 'text/html' });
        response.end(pages[request.url] || '');
    });
}

// What the app comes back to: the Editor's files, the Browser's two tabs on the site at `origin`, and Notifications'
// record, each record a value the app's storage takes (`valueProblem`, deckit-sdk/deckit/request), so a mod can write
// back what it read.
function seedOf(origin, valueProblem) {
    return ({ data, files: given }) => {
        const files = path.join(given, FOLDER);
        for (const [name, text] of Object.entries(FILES)) {
            fs.mkdirSync(path.dirname(path.join(files, name)), { recursive: true });
            fs.writeFileSync(path.join(files, name), text);
        }
        const shown = path.join(files, SHOWN);
        const records = path.join(data, 'deckit', 'records');
        const write = (name, value) => {
            const problem = valueProblem(value, name);
            if (problem) throw new Error(`the seed is refused: ${problem}`);
            fs.mkdirSync(path.dirname(path.join(records, name)), { recursive: true });
            fs.writeFileSync(path.join(records, name), JSON.stringify(value));
        };
        write('editor/session.json', {
            spaces: [{ root: files, open: [shown], active: shown, mode: 'files' }],
            active: files,
        });
        const tabs = [
            { id: 1, url: origin + '/', title: 'Example', icon: '' },
            { id: 2, url: origin + '/behind', title: 'Behind', icon: '' },
        ];
        write('browser/session.json', { tabs, front: 1, closed: [] });
        // A user that attaches asks to sit, so the one that asks is drawn.
        const state = path.join(data, 'deckit', 'state');
        fs.mkdirSync(state, { recursive: true });
        fs.writeFileSync(path.join(state, 'seats.json'), JSON.stringify({ asking: true }));
        const posted = Date.now();
        write(
            'notifications/notifications.json',
            [
                ['calendar', 'Calendar', 'Design review', 'In 10 minutes, Room 4', 4],
                ['forge', 'Forge', 'Build finished', 'deckit built in 42 s, 175 checks passed', 26],
                ['bot', 'Bot', 'Reply ready', 'The summary of the meeting notes is ready to read.', 90],
            ].map(([id, name, title, body, minutes], at) => ({
                id: `seeded-${at}`,
                mod: { id, name },
                title,
                body,
                silent: false,
                actions: [],
                posted: posted - minutes * 60000,
            }))
        );
    };
}

// Every surface in `look`, each into `shots`; the names of those not drawn.
async function draw(app, look, shots, origin) {
    const { page, pages, pageById, overlayOf, compose, main } = app;
    const {
        desktopLaid,
        windowsNow,
        keyMod,
        windowOf,
        dockNow,
        show,
        desktopShot,
        allowed,
        answerOf,
        answer,
        pressAt,
        seatsView,
    } = seat({
        main,
        pageById,
        compose,
        desktop: () => desktop,
    });
    const missed = [];
    // `take(name)` draws surface `name`, which is missed if it threw or drew nothing.
    const surface = async (name, take) => {
        try {
            await take(name);
        } catch (error) {
            console.error(`[shots] ${look} ${name}: ${error.message}`);
        }
        if (!fs.existsSync(path.join(shots, name + '.png'))) missed.push(name);
    };
    // Mod `id`'s front window alone over the desktop's backdrop: its frame, its content and the pages laid in it, and
    // with `overlay` what its page presents over it.
    const windowShot = async (name, id, { overlay = false } = {}) => {
        const laid = (await desktopLaid())?.pages || [];
        const window = (await windowsNow()).filter(({ mod }) => mod === id).at(-1);
        if (!window) return;
        const from = laid.findIndex(({ name: each }) => each === `frame-${window.id}`);
        const to = laid.findIndex(({ name: each }) => each === `buttons-${window.id}`);
        if (from < 0 || to < 0) return;
        const opener = laid.find(({ id: each }) => each === window.content)?.opener;
        const drawn = laid.slice(from, to + 1);
        if (overlay) drawn.push(...laid.filter((each) => each.name === 'deckit-overlay' && each.opener === opener));
        drawn.unshift(...laid.filter(({ name: each }) => each === 'backdrop'));
        const layers = [];
        for (const { id: each, rect, clips, hidden } of drawn) {
            const session = !hidden && (await pageById(each));
            if (session) layers.push({ session, x: rect.x, y: rect.y, clips });
        }
        await compose(name, layers, { crop: laid[from].rect, under });
    };
    // The switcher's floating window, centred across the desktop a fifth of the way down as it floats there, with a
    // margin of what is behind it.
    const floatingShot = async (name, session) => {
        const [width, height] = await session.evaluate('[innerWidth, innerHeight]');
        const rect = { x: (screen.width - width) / 2, y: (screen.height - height) / 5, width, height };
        const crop = { x: rect.x - MARGIN, y: rect.y - MARGIN, width: width + 2 * MARGIN, height: height + 2 * MARGIN };
        const clips = [{ rect, radius: CORNER }];
        await compose(name, [{ session, x: rect.x, y: rect.y, clips }], { crop, under });
    };
    const backed = (name) => desktopShot(name, { under });
    // The overlay of mod `id`'s page once `expression` comes to something in it, or nothing after a few seconds.
    const presented = async (id, expression) => {
        const overlay = await overlayOf(await page(`deckit://${id}.mod`));
        return (await until(() => overlay?.evaluate(expression), 4000)) && overlay;
    };
    const escape = (overlay) => overlay?.key('Escape', 'Escape');

    await sleep(9000);
    const desktop = await until(() => page('deckit://desktop'));
    // The menu of the Dock's first item, which the desktop's page draws in itself, opened by a context press on the
    // item: its rect in the page once it shows, or null after a few seconds. `dockMenuAway` puts it away by its key.
    const dockMenu = async () => {
        await desktop.evaluate(`(() => {
            const item = document.querySelector('.deckit-dock-item');
            const { x, y } = item.getBoundingClientRect();
            item.dispatchEvent(new MouseEvent('contextmenu', { bubbles: true, cancelable: true, clientX: x + 8, clientY: y + 8 }));
        })()`);
        return until(
            () =>
                desktop.evaluate(`(() => {
                    const menu = document.querySelector('.deckit-dock-menu:not([hidden])');
                    if (!menu) return null;
                    const { x, y, width, height } = menu.getBoundingClientRect();
                    return width && height ? { x, y, width, height } : null;
                })()`),
            3000
        );
    };
    const dockMenuAway = () =>
        desktop.evaluate(
            `document.querySelector('.deckit-dock-menu').dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }))`
        );

    // The stand-in drawn once, in the desktop's page, and laid under each shot at the screen's size.
    const screen = (await until(desktopLaid)).rect;
    const backdrop = await desktop.evaluate(`(${wallpaper})(${screen.width}, ${screen.height}, ${BLUR})`);
    const under = `async (context, scale) => {
        const image = new Image();
        image.src = 'data:image/png;base64,${backdrop}';
        await image.decode();
        context.drawImage(image, 0, 0, ${screen.width} * scale, ${screen.height} * scale);
    }`;
    const dark = await main(`const { nativeTheme } = require('electron');
        nativeTheme.themeSource = ${JSON.stringify(look)};
        return nativeTheme.shouldUseDarkColors`);
    if (dark !== (look === 'dark')) throw new Error(`the app did not take the ${look} look`);
    // What the Browser downloads is kept with the app's data, out of the person's Downloads folder.
    const downloads = path.join(app.data, 'Downloads');
    fs.mkdirSync(downloads, { recursive: true });
    await main(`require('electron').app.setPath('downloads', ${JSON.stringify(downloads)})`);
    await sleep(1500);
    await surface('desktop', backed);

    // Each app in the Dock, its window the key one, then behind another's.
    const apps = (await dockNow()).map(({ id }) => id);
    for (const id of apps)
        await surface(id, async (name) => {
            await show(id);
            await sleep(800);
            await windowShot(name, id);
        });
    for (const id of apps.slice(0, -1)) await surface(`${id}-inactive`, (name) => windowShot(name, id));
    await show(apps[0]);
    await sleep(400);
    await surface(`${apps.at(-1)}-inactive`, (name) => windowShot(name, apps.at(-1)));
    await surface('desktop-windows', backed);
    // Two users sit beside the local seat, each at a transport connection of its own with a key of its own, let in by
    // the local seat's press on Allow in the view of Seats where it is asked, and each presses a window where it shows for it, so it holds
    // that window's keyboard, and tiles it by the shell's key, one to each half, so the title bars of both show: their
    // cursors at rest under them, a third user asking to sit, the view of one of them followed, then one of them mid
    // drag, its button held. Each window is put back at its frame after.
    const attach = async (id, name) => {
        const file = path.join(app.data, `${id}.key`);
        const command = path.join(__dirname, '..', 'deckit');
        execFileSync(command, ['user', 'add', id, '--name', name, '--key', file, '--home', app.home], {
            stdio: 'pipe',
        });
        const party = await connect(path.join(app.home, 'deckit.sock'));
        await allowed(name, party.authenticate({ principal: id, ...readKey(fs.readFileSync(file, 'utf8')) }));
        const point = (type, { x, y }, more = {}) =>
            party.request('seat/input', { event: 'pointer', type, x, y, ...more });
        // The shell's key that tiles the seat's key window, by the arrow it is.
        const tile = async (code) => {
            for (const type of ['down', 'up'])
                await party.request('seat/input', {
                    event: 'key',
                    type,
                    code,
                    key: code,
                    modifiers: ['control', 'alt'],
                });
        };
        return { point, tile, leave: () => party.close() };
    };
    // A point where one of `windows` shows for `user`, whose windows are in an order of its own, and that window.
    const shownTo = async (user, windows) => {
        for (const { rect } of windows)
            for (const down of [0.5, 0.25, 0.75])
                for (let across = 6; across < rect.width; across += 18) {
                    const at = { x: Math.round(rect.x + across), y: Math.round(rect.y + rect.height * down) };
                    const { over } = await user.point('scroll', at, { dx: 0, dy: 1 });
                    const window = windows.find(({ id }) => id === over);
                    if (window) return { at, window };
                }
        throw new Error('no window shows for a seat');
    };
    const around = (points) => {
        const [xs, ys] = [points.map(({ x }) => x), points.map(({ y }) => y)];
        const [left, top] = [Math.max(0, Math.min(...xs) - 240), Math.max(0, Math.min(...ys) - 200)];
        const [right, bottom] = [Math.max(...xs) + 240, Math.max(...ys) + 200];
        return {
            x: left,
            y: top,
            width: Math.min(screen.width, right) - left,
            height: Math.min(screen.height, bottom) - top,
        };
    };
    const users = [];
    const rests = [];
    const held = []; // the window each of the two holds, tiled
    // The desktop's top right, down to under the view of Seats as it is laid.
    const underItem = ({ rect }) => {
        const x = Math.max(0, Math.round(rect.x) - 80);
        return { x, y: 0, width: screen.width - x, height: Math.round(rect.y + rect.height) + 40 };
    };
    await surface('seats', async (name) => {
        users.push(await attach('ada', 'Ada'), await attach('grace', 'Grace'));
        const behind = (await windowsNow()).filter(({ key, scaled }) => !key && !scaled);
        for (const [nth, user] of users.entries()) {
            const { at, window } = await shownTo(user, behind);
            behind.splice(behind.indexOf(window), 1);
            await user.point('down', at, { button: 0, buttons: [0], count: 1 });
            await user.point('up', at, { button: 0, buttons: [] });
            await user.tile(nth ? 'ArrowRight' : 'ArrowLeft');
            held.push(window.id);
        }
        await sleep(1200);
        const tiled = (await windowsNow()).filter(({ id }) => held.includes(id));
        for (const [nth, user] of users.entries()) {
            const { rect } = tiled.find(({ id }) => id === held[nth]);
            rests.push({ x: Math.round(rect.x + 150), y: Math.round(rect.y + 56) });
            await user.point('move', rests.at(-1));
        }
        await sleep(600);
        const bottom = Math.max(...rests.map(({ y }) => y)) + 80;
        await desktopShot(name, { under, crop: { x: 0, y: 0, width: screen.width, height: bottom } });
    });
    // The view of Seats under its item in the status bar: a row for the local seat and for each of the two.
    await surface('seats-view', async (name) => {
        const view = await seatsView.shown();
        if (!view) throw new Error('the view of Seats is not shown');
        await sleep(400);
        await desktopShot(name, { under, crop: underItem(view) });
        await seatsView.away();
    });
    // A third user asks to sit: its row over theirs, with its two answers, until the local seat denies it.
    await surface('seats-ask', async (name) => {
        const file = path.join(app.data, 'lin.key');
        const command = path.join(__dirname, '..', 'deckit');
        execFileSync(command, ['user', 'add', 'lin', '--name', 'Lin', '--key', file, '--home', app.home], {
            stdio: 'pipe',
        });
        const party = await connect(path.join(app.home, 'deckit.sock'));
        const refused = party.authenticate({ principal: 'lin', ...readKey(fs.readFileSync(file, 'utf8')) }).then(
            () => party.close(),
            () => {}
        );
        const asked = await answerOf('Lin', 'deny', 5000);
        if (asked) await desktopShot(name, { under, crop: underItem(asked.view) });
        await answer('Lin', 'deny', 1000);
        await refused;
    });
    // The local seat follows the first of the two by a press on its row: the whole desktop as that seat has it, and
    // the bar that says so.
    await surface('seats-followed', async (name) => {
        await seatsView.pressIn(await seatsView.shown(), '.seats-seat[aria-label^="Ada"]');
        await sleep(1200);
        await desktopShot(name, { under });
        await pressAt({ x: Math.round(screen.width / 2), y: Math.round(screen.height / 2) });
        await sleep(800);
    });
    await surface('seats-drag', async (name) => {
        const [from, other] = rests;
        if (!other) throw new Error('no two seats are at rest');
        const to = { x: from.x + 150, y: from.y + 70 };
        await users[0].point('down', from, { button: 0, buttons: [0], count: 1 });
        await users[0].point('move', to, { buttons: [0] });
        await sleep(600);
        await desktopShot(name, { under, crop: around([from, to, other]) });
        await users[0].point('up', to, { button: 0, buttons: [] });
    });
    // Three seats' cursors by what covers them for the local seat. One of the two is on its own window where the
    // local seat has another window in front, so it is not seen; a third user, who has that same window in front, is
    // at the edge of the window that covers it, cut there; the other of the two is at rest on a window that shows,
    // whole. The third leaves after.
    await surface('seats-under', async (name) => {
        const all = await windowsNow();
        const within = ({ x, y, width, height }, at) => at.x >= x && at.y >= y && at.x < x + width && at.y < y + height;
        const shared = (one, other) => {
            const [x, y] = [Math.max(one.x, other.x), Math.max(one.y, other.y)];
            const width = Math.min(one.x + one.width, other.x + other.width) - x;
            const height = Math.min(one.y + one.height, other.y + other.height) - y;
            return width > 80 && height > 80 ? { x, y, width, height } : null;
        };
        for (const [nth, user] of users.entries()) {
            const at = all.findIndex(({ id }) => id === held[nth]);
            const above = at < 0 ? [] : all.slice(at + 1).map(({ rect }) => rect);
            const cover = above.flatMap((rect) => shared(all[at].rect, rect) ?? [])[0];
            if (!cover || !users[1 - nth]) continue;
            const covered = { x: Math.round(cover.x + 40), y: Math.round(cover.y + 40) };
            // A point of the seat's window 9 px outside an edge of what covers it, where nothing else covers it.
            const [across, down] = [Math.round(cover.x + 60), Math.round(cover.y + 100)];
            const edge = [
                { x: Math.round(cover.x) - 9, y: down },
                { x: Math.round(cover.x + cover.width) - 9, y: down },
                { x: across, y: Math.round(cover.y) - 9 },
                { x: across, y: Math.round(cover.y + cover.height) - 9 },
            ].find((each) => within(all[at].rect, each) && !above.some((rect) => within(rect, each)));
            if (!edge) continue;
            const third = await attach('alan', 'Alan');
            const shown = await shownTo(third, [all[at]]);
            await third.point('down', shown.at, { button: 0, buttons: [0], count: 1 });
            await third.point('up', shown.at, { button: 0, buttons: [] });
            await user.point('move', covered);
            await third.point('move', edge);
            await users[1 - nth].point('move', rests[1 - nth]);
            await sleep(600);
            await desktopShot(name, { under, crop: around([covered, edge, rests[1 - nth]]) });
            third.leave();
            await sleep(600);
            return;
        }
        throw new Error("no seat's window lies under another for the local seat with an edge of that one on it");
    });
    // The two seats' cursors over what lies over the desktop's page: one on the status bar's panel window in the
    // host's bar, the other on the menu of a Dock item, which the desktop's page draws in itself.
    await surface('seats-over', async (name) => {
        const [first, second] = users;
        if (!second) throw new Error('no two seats are at the desktop');
        const middle = ({ x, y, width, height }) => ({ x: Math.round(x + width / 2), y: Math.round(y + height / 2) });
        const panel = ((await desktopLaid())?.pages || []).find(
            ({ opener, name: each }) => opener.startsWith('deckit://status-bar.mod') && /^deckit-window-/.test(each)
        );
        if (!panel) throw new Error('no panel window of the status bar is laid');
        const menu = await dockMenu();
        if (!menu) throw new Error("the Dock's menu did not open");
        await first.point('move', middle(menu));
        await second.point('move', middle(panel.rect));
        await sleep(600);
        await desktopShot(name, { under });
        await dockMenuAway();
        await sleep(300);
    });
    for (const user of users) await user.tile('ArrowDown').catch(() => {});
    for (const user of users) user.leave();
    await sleep(1000);
    // Two windows tiled side by side by the shell's keys, then each put back at its frame.
    const tileKey = async (key) => {
        const content = (await windowsNow()).find((window) => window.key)?.content;
        await (await pageById(content))?.key(key, key, CTRL | ALT);
        await sleep(800);
    };
    await surface('windows-tiled', async (name) => {
        await show(apps[0]);
        await sleep(400);
        await tileKey('ArrowLeft');
        await show(apps[1]);
        await sleep(400);
        await tileKey('ArrowRight');
        await backed(name);
        await tileKey('ArrowDown');
        await show(apps[0]);
        await sleep(400);
        await tileKey('ArrowDown');
    });
    // The half the Browser's window takes, shown as it is held by its toolbar with the pointer at the zoom area's left
    // side, then dragged back to where it was pressed and let go there.
    await surface('window-drop', async (name) => {
        await show('browser');
        await sleep(600);
        const held = (await windowsNow()).filter(({ mod }) => mod === 'browser').at(-1);
        const from = await (
            await pageById(held?.content)
        )?.evaluate(`(() => {
            const bar = document.querySelector('.browser-toolbar').getBoundingClientRect();
            const y = Math.round(bar.top + bar.height / 2);
            for (let x = Math.round(bar.left) + 96; x < bar.right; x += 4) {
                const found = document.elementFromPoint(x, y);
                if (found && getComputedStyle(found).getPropertyValue('--app-region').trim() === 'drag') return { x, y };
            }
            return null;
        })()`);
        if (!from) return;
        const mouse = (type, { x, y }) =>
            main(`return webkit.sendMouse(${held.content}, ${JSON.stringify({ type, x, y })})`);
        const rectNow = async () => (await windowsNow()).find(({ id }) => id === held.id)?.rect ?? held.rect;
        // Where the pointer at `point` on the desktop is in the window's content as it is laid now.
        const inPage = async (point) => {
            const rect = await rectNow();
            return { x: point.x - rect.x, y: point.y - rect.y };
        };
        const top = await desktop.evaluate(`document.querySelector('.deckit-desktop-strip').offsetHeight`);
        const pressed = { x: held.rect.x + from.x, y: held.rect.y + from.y };
        await mouse('down', from);
        await mouse('dragged', await inPage({ x: 6, y: Math.round(top + (screen.height - top) / 2) }));
        await sleep(800);
        await backed(name);
        await mouse('dragged', await inPage(pressed));
        await sleep(200);
        await mouse('up', await inPage(pressed));
        await sleep(600);
    });
    // The status bar at the top right of the host's bar, close, with the Notifications item and its count, and the
    // desktop with the notification center a press on that item shows under it, with the record's cards, then
    // cleared, with none.
    await surface('status-bar', (name) =>
        desktopShot(name, { under, crop: { x: screen.width - 320, y: 0, width: 320, height: 52 } })
    );
    // The Notifications item in the status bar's document: a press on it runs the mod's command.
    const bell = {
        press: async () => {
            for (const each of await pages('about:blank'))
                if (await each.evaluate(`!!document.querySelector('.status-bar-item[data-item="notifications"]')`))
                    return each.press('.status-bar-item[data-item="notifications"]');
        },
    };
    const center = () =>
        until(async () => {
            for (const each of await pages('about:blank'))
                if (await each.evaluate(`!!document.querySelector('.notifications-head')`)) return each;
            return null;
        }, 4000);
    // Whether the center is laid on the desktop.
    const centerOpen = async () =>
        ((await desktopLaid())?.pages || []).some(
            ({ opener, name }) => opener.startsWith('deckit://notifications.mod') && /^deckit-window-/.test(name)
        );
    await surface('notifications', async (name) => {
        await bell.press();
        const list = await center();
        await until(() => list?.evaluate(`!!document.querySelector('.notifications-card')`), 2000);
        await sleep(600);
        if (list) await backed(name);
    });
    await surface('notifications-empty', async (name) => {
        const list = await center();
        await list?.press('.notifications-head button');
        await until(() => list?.evaluate(`!document.querySelector('.notifications-card')`), 2000);
        await sleep(400);
        if (list) await backed(name);
        // The item's press lands before the Dock's: a Dock press first puts the center away, and the item's then
        // shows it again.
        await bell.press();
        await until(async () => !(await centerOpen()), 4000);
        await show(apps[0]);
        await sleep(400);
    });

    // The Dock slid out as the pointer comes, and the menu of one of its items.
    const dock = (event) =>
        desktop.evaluate(`document.querySelector('.deckit-dock').dispatchEvent(new PointerEvent('${event}'))`);
    await dock('pointerenter');
    await until(() => desktop.evaluate(`document.querySelector('.deckit-dock').hasAttribute('data-out')`), 2000);
    await sleep(400);
    await surface('dock', backed);
    await surface('dock-menu', async (name) => {
        if (!(await dockMenu())) throw new Error("the Dock's menu did not open");
        await sleep(300);
        await backed(name);
        await dockMenuAway();
    });
    await dock('pointerleave');

    // The switcher, on its chord, empty and with a search typed.
    const keyed = await windowOf(await keyMod());
    await keyed?.key(' ', 'Space', ALT);
    const switcher = await until(async () => overlayOf(await page('deckit://switcher.mod')));
    await until(async () => /Notes/.test((await switcher?.evaluate('document.body.innerText')) || ''));
    await sleep(300);
    await surface('switcher', (name) => floatingShot(name, switcher));
    await switcher?.type('Show Notes');
    await sleep(1200);
    await surface('switcher-typed', (name) => floatingShot(name, switcher));
    await escape(switcher);
    await sleep(600);

    // Settings, section by section, then a menu, a sheet and a toast over it.
    await show('settings');
    const settings = await windowOf('settings');
    await until(async () => /Editor[\s\S]*1\.0\.0/.test((await settings?.evaluate('document.body.innerText')) || ''));
    const titles =
        (await settings?.evaluate(
            `[...document.querySelectorAll('.settings-section-title')].map((title) => title.textContent)`
        )) || [];
    const sectionOf = (title) => `[...document.querySelectorAll('.settings-section')].find((section) =>
        section.querySelector('.settings-section-title')?.textContent === ${JSON.stringify(title)})`;
    for (const title of titles)
        await surface('settings-' + title.toLowerCase().replace(/[^a-z0-9]+/g, '-'), async (name) => {
            await settings.evaluate(`${sectionOf(title)}.scrollIntoView({ block: 'start' })`);
            await sleep(300);
            await windowShot(name, 'settings');
        });
    // Activity at a mod with no icon of its own, Keymap, drawn with the default icon.
    await surface('settings-activity-default-icon', async (name) => {
        await settings.evaluate(`[...${sectionOf('Activity')}.querySelectorAll('*')]
            .find((each) => !each.childElementCount && each.textContent === 'Keymap')
            ?.scrollIntoView({ block: 'center' })`);
        await sleep(300);
        await windowShot(name, 'settings');
    });
    await surface('menu', async (name) => {
        const select = `${sectionOf('General')}.querySelector('.deckit-select')`;
        await settings.evaluate(`${select}.scrollIntoView({ block: 'center' })`);
        await sleep(200);
        await settings.evaluate(`${select}.click()`);
        const overlay = await presented('settings', `!!document.querySelector('.deckit-menu[data-state="open"]')`);
        await sleep(300);
        await windowShot(name, 'settings', { overlay: true });
        await escape(overlay);
    });
    // A folder dropped on the Mods section: one whose package names a mod not installed is said in the notice over
    // the list, one that asks for a permission and depends on a mod installed is asked on a sheet, and one that is no
    // mod is told on a toast.
    const settingsId = (await windowsNow()).find(({ mod }) => mod === 'settings')?.content;
    const drop = async (folder) => {
        const at = await settings.evaluate(`(() => {
            const head = document.querySelector('.settings-mods .settings-section-head');
            head.scrollIntoView();
            const box = head.getBoundingClientRect();
            return { x: box.left + 20, y: box.top + 10 };
        })()`);
        await main(`return webkit.sendDrop(${settingsId}, ${JSON.stringify({ files: [folder], ...at })})`);
    };
    const modFolder = (id, name, extra) => {
        const folder = path.join(app.data, id);
        fs.mkdirSync(folder);
        fs.writeFileSync(
            path.join(folder, 'manifest.toml'),
            `id = "${id}"\nname = "${name}"\nversion = "1.0.0"\napi = "1.0.0"\nmain = "main.js"\n${extra}`
        );
        fs.writeFileSync(path.join(folder, 'main.js'), 'module.exports = class { start() {} };\n');
        return folder;
    };
    await surface('settings-mods-unmet', async (name) => {
        const folder = modFolder('needs-absent', 'Needs Absent', '');
        fs.writeFileSync(path.join(folder, 'package.toml'), '[dependencies]\nabsent-mod = "1.2"\n');
        await drop(fs.realpathSync(folder));
        await until(() => settings.evaluate(`!document.querySelector('.settings-unmet')?.hidden`), 4000);
        await sleep(400);
        await windowShot(name, 'settings');
    });
    await surface('sheet', async (name) => {
        const folder = modFolder(
            'asks-network',
            'Weather',
            '\n[permissions]\n"system.network" = "Reads the forecast."\n'
        );
        fs.writeFileSync(path.join(folder, 'package.toml'), '[dependencies]\nforge = "1.0"\n');
        await drop(fs.realpathSync(folder));
        const overlay = await presented('settings', `!!document.querySelector('.deckit-modal-title')`);
        await sleep(400);
        await windowShot(name, 'settings', { overlay: true });
        await overlay?.evaluate(`[...document.querySelectorAll('.deckit-modal-actions button')]
            .find((button) => button.textContent === 'Cancel')?.click()`);
        await until(async () => !(await overlay?.evaluate(`!!document.querySelector('.deckit-modal')`)), 2000);
    });
    await surface('toast', async (name) => {
        const folder = path.join(app.data, 'not-a-mod');
        fs.mkdirSync(folder);
        await drop(fs.realpathSync(folder));
        await presented('settings', `!!document.querySelector('.deckit-toast')`);
        await sleep(400);
        await windowShot(name, 'settings', { overlay: true });
    });
    // A toast of Notifications' at the top right of the desktop, close: the one Calendar's button in Settings posts,
    // drawn while it stands and left to go. None is posted where the run would raise a notification of the system's.
    await surface('notifications-toast', async (name) => {
        if ((await main(`return require('electron').Notification.isSupported()`)) !== false) return;
        const toast = async () => {
            for (const each of await pages('about:blank'))
                if (await each.evaluate(`!!document.querySelector('.notifications-toasts .notifications-card')`))
                    return each;
            return null;
        };
        await settings.evaluate(`[...document.querySelectorAll('button')]
            .find((button) => button.textContent.trim() === 'Send a test')?.click()`);
        const stands = await until(toast, 4000);
        await sleep(600);
        if (stands) await desktopShot(name, { under, crop: { x: screen.width - 400, y: 0, width: 400, height: 180 } });
        await until(async () => !(await toast()), 9000);
    });

    // The Browser: a tab's context menu, the question a download asks, and the downloads listed from the toolbar.
    await show('browser');
    const browser = await windowOf('browser');
    await surface('context-menu', async (name) => {
        await browser.evaluate(`(() => {
            const row = document.querySelector('.browser-row-label');
            const { x, y } = row.getBoundingClientRect();
            row.dispatchEvent(new MouseEvent('contextmenu', { bubbles: true, cancelable: true, clientX: x + 4, clientY: y + 4 }));
        })()`);
        const overlay = await presented('browser', `!!document.querySelector('.deckit-menu[data-state="open"]')`);
        await sleep(300);
        await windowShot(name, 'browser', { overlay: true });
        await escape(overlay);
        await until(async () => !(await overlay?.evaluate('document.body.childElementCount')), 2000);
    });
    await surface('dialog', async (name) => {
        const shown = `[...document.querySelectorAll('[data-web-page]')].find((element) =>
            element.style.visibility === 'visible')?.dataset.webPage`;
        const tab = await until(() => browser.evaluate(shown), 3000);
        await main(`return webkit.load(${tab}, ${JSON.stringify(origin + '/report.csv')})`);
        const overlay = await presented('browser', `!!document.querySelector('.deckit-modal-title')`);
        await sleep(400);
        await windowShot(name, 'browser', { overlay: true });
        await overlay?.evaluate(`[...document.querySelectorAll('.deckit-modal-actions button')]
            .find((button) => button.textContent === 'Download')?.click()`);
        await until(() => fs.existsSync(path.join(downloads, 'report.csv')), 5000);
    });
    await surface('popover', async (name) => {
        const button = `document.querySelector('.browser-downloads-button')`;
        await until(() => browser.evaluate(`!${button}.hidden`), 3000);
        await browser.evaluate(`${button}.click()`);
        const overlay = await presented('browser', `!!document.querySelector('.browser-download')`);
        await sleep(400);
        await windowShot(name, 'browser', { overlay: true });
        await escape(overlay);
    });

    // The page a tab shows in place of one that failed to load, at an address nothing answers at, its game at rest.
    await surface('load-failure', async (name) => {
        const shown = `[...document.querySelectorAll('[data-web-page]')].find((element) =>
            element.style.visibility === 'visible')?.dataset.webPage`;
        const tab = await until(() => browser.evaluate(shown), 3000);
        const held = net.createServer();
        await new Promise((resolve) => held.listen(0, '127.0.0.1', resolve));
        const refused = `http://127.0.0.1:${held.address().port}/`;
        await new Promise((resolve) => held.close(resolve));
        await main(`return webkit.load(${tab}, ${JSON.stringify(refused)})`);
        await until(() => browser.evaluate(`!!document.querySelector('.browser-failure[data-shown]')`), 5000);
        await sleep(400);
        await windowShot(name, 'browser');
        await main(`return webkit.load(${tab}, ${JSON.stringify(origin + '/')})`);
        await until(() => browser.evaluate(`!document.querySelector('.browser-failure[data-shown]')`), 5000);
    });

    // The quick picks: the Editor's Go to Line and Open Quickly, and the Finder's Go to Folder.
    const quickPick = (id, key, code, typed) => async (name) => {
        await show(id);
        const content = await windowOf(id);
        if (id === 'editor') await content.press('.cm-content');
        await sleep(300);
        await content.key(key, code, META);
        const overlay = await presented(id, `!!document.querySelector('.deckit-quick-pick-field')`);
        if (typed) await overlay?.type(typed);
        await sleep(800);
        await windowShot(name, id, { overlay: true });
        await escape(overlay);
        await sleep(300);
    };
    await surface('quick-pick', quickPick('editor', 'l', 'KeyL'));
    await surface('open-quickly', quickPick('editor', 'p', 'KeyP', 'greet'));
    await surface('go-to-folder', quickPick('finder', 'l', 'KeyL'));
    return missed;
}

const main = async () => {
    execFileSync(path.join(__dirname, 'build'), { cwd: root, stdio: 'inherit' });
    const request = path.join(root, 'source', 'deckit', 'deckit-sdk', 'deckit', 'request', 'index.js');
    const { valueProblem } = await import(pathToFileURL(request).href);
    fs.rmSync(OUT, { recursive: true, force: true });
    const server = site();
    await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
    const origin = `http://127.0.0.1:${server.address().port}`;
    const missed = [];
    for (const look of LOOKS) {
        const shots = path.join(OUT, look);
        fs.mkdirSync(shots, { recursive: true });
        const log = path.join(OUT, look + '.log');
        const app = start({ seed: seedOf(origin, valueProblem), shots, log, port, limit: LIMIT });
        try {
            missed.push(...(await draw(app, look, shots, origin)).map((name) => `${look}/${name}`));
        } finally {
            app.stop();
            await sleep(2000);
        }
        const drawn = fs.readdirSync(shots).filter((file) => file.endsWith('.png'));
        console.log(`${look}: ${drawn.length} shots in ${path.relative(root, shots)}/`);
    }
    server.close();
    if (!missed.length) process.exit(0);
    console.error(`not drawn: ${missed.join(', ')}`);
    process.exit(1);
};

main().catch((error) => {
    console.error('[shots] ' + error.message);
    process.exit(1);
});
