#!/usr/bin/env node
// Checks the channels between main and a page, the stage pages are laid on, what an environment gives and connect
// answers, deck's client of the core, its runner, the exports a page opens by interface, the mods a connection
// launches, the scope a lifecycle cuts and the events a page hears, deckit as a layer on deck, the key map, the mods as
// the core reads them, an address offered to its handlers in turn, the web pages a mod shows, what a page is told as it
// starts, the styles a page wears, the regions mods give their children, forge's runs, the commands, urls, keymap and
// configuration mods, the Switcher's list, Settings' Activity and the Mods mod's search, runs the core's tests, then
// drives Deckit.app, put together from the archive it builds first, through the scenario, with data of its own that is
// thrown away. Exits 1 with a line for each check that failed. Screenshots and the app's log are left in .build/test/.
const fs = require('fs');
const path = require('path');

const root = path.join(__dirname, '..', '..', '..');
const { execFileSync } = require('child_process');
const { start } = require(path.join(root, 'source', 'cli', 'test', 'start.js'));
const { sleep } = require(path.join(root, 'source', 'cli', 'test', 'devtools.js'));
const SCENARIO = require(path.join(root, 'source', 'cli', 'test', 'scenario.js'));
const OUT = path.join(root, '.build', 'test');
const LIMIT = 300000;

const args = process.argv.slice(2);
const port = args.length ? Number(args[1]) : 9334;
if ((args.length && (args.length !== 2 || args[0] !== '--port')) || !Number.isInteger(port) || port <= 0) {
    console.error("usage: deckit test [--port <the main process's inspector port, default 9334>]");
    process.exit(2);
}

const main = async () => {
    execFileSync(path.join(__dirname, 'build'), { cwd: root, stdio: 'inherit' });
    const checks = [
        'channels.js',
        'stage.js',
        'environment.js',
        'core.js',
        'runner.js',
        'exports.js',
        'connection.js',
        'scope.js',
        'event.js',
        'layers.js',
        'keymap.js',
        'catalog.js',
        'open.js',
        'web.js',
        'main-process.js',
        'page.js',
        'desktop.js',
        'window.js',
        'dock.js',
        'host.js',
        'key.js',
        'style.js',
        'region.js',
        'forge.js',
        'commands.js',
        'urls.js',
        'keymap-mod.js',
        'configuration.js',
        'packages.js',
        'switcher.js',
        'notifications.js',
        'activity.js',
        'all-mods.js',
    ];
    for (const check of checks)
        execFileSync(process.execPath, ['--no-warnings', path.join(root, 'source', 'cli', 'test', check)], {
            stdio: 'inherit',
        });
    const core = path.join(root, 'source', 'deckit', 'deckit');
    const scratch = path.join(root, '.build', 'core-test');
    execFileSync('swift', ['test', '--quiet', '--package-path', core, '--scratch-path', scratch], { stdio: 'inherit' });
    fs.rmSync(OUT, { recursive: true, force: true });
    fs.mkdirSync(OUT, { recursive: true });
    const log = path.join(OUT, 'log.txt');
    const app = start({ seed: SCENARIO.seed, shots: OUT, log, port, limit: LIMIT });
    const report = await SCENARIO.run(app);
    app.stop();
    await sleep(1000);
    fs.writeFileSync(path.join(OUT, 'report.json'), JSON.stringify(report, null, 4) + '\n');

    const failed = report.filter(({ ok }) => !ok);
    const shown = path.relative(root, OUT) + '/';
    if (!failed.length) {
        console.log(`ok: ${report.length} checks, on Deckit.app as it was just built (screenshots in ${shown})`);
        process.exit(0);
    }
    for (const { name, detail } of failed) console.error(`FAIL ${name}${detail ? ': ' + detail.slice(0, 300) : ''}`);
    const lines = fs.existsSync(log) ? fs.readFileSync(log, 'utf8').split('\n') : [];
    const worth = lines.filter((line) => /error|failed|threw|refused/i.test(line));
    if (worth.length) console.error('the app logged:\n' + worth.slice(0, 30).join('\n'));
    console.error(`${failed.length} of ${report.length} checks failed (the app's log is ${shown}log.txt)`);
    process.exit(1);
};

main().catch((error) => {
    console.error('[test] ' + error.message);
    process.exit(1);
});
