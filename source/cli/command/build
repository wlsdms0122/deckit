#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../../.."

source/cli/command/check || { echo "the files do not hold to their modules: stopping" >&2; exit 1; }

VERSION="$(awk -F'"' '/^\[package\]/{p=1;next} /^\[/{p=0} p&&/^version[ \t]*=/{print $2;exit}' manifest.toml)"
OUT=.build
# Built in a folder of its own and moved in whole at the end: `deckit dev` may run two builds at once.
mkdir -p "$OUT"
WORK="$(mktemp -d "$OUT/.building.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
LIB="$WORK/lib"
mkdir -p "$LIB/document" "$LIB/mods"
SOURCE_HASH="$({ find source/deckit/deckit source/deckit/deckit-electron source/deckit/deckit-shell source/deckit/mods source/cli/library.js source/cli/bundle.js source/cli/command/build -type f -not -name .DS_Store -not -path '*/node_modules/*' -not -path '*/.build/*' -not -path '*/.swiftpm/*' -print0 | LC_ALL=C sort -z | xargs -0 shasum -a 256; } | shasum -a 256 | cut -c1-12)"

cp document/EMBEDDING.md document/MOD.md document/UI.md "$LIB/document/"

# deckit's own mods keep their sandbox code as CommonJS files under src/, with src/main.js the entry; what the
# manifest's main names is that, bundled from src/ alone, with the licences it carries. The rest of the folder ships as
# it is.
ESBUILD=esbuild@0.28.2
for dir in source/deckit/mods/*/; do
  dir="${dir%/}"
  [ -f "$dir/manifest.toml" ] || continue
  rsync -a --exclude .DS_Store --exclude "/$(basename "$dir")/src" "$dir" "$LIB/mods/"
  MAIN="$(node -p "require('fs').readFileSync('$dir/manifest.toml','utf8').match(/^main\\s*=\\s*\"([^\"]+)\"/m)[1]")"
  OUTFILE="$PWD/$LIB/mods/$(basename "$dir")/$MAIN"
  ( cd "$dir/src" && npx --yes "$ESBUILD" main.js --bundle --format=cjs --platform=browser --target=chrome120 \
      --legal-comments=eof --log-level=warning --metafile="$OLDPWD/$WORK/meta.json" --outfile="$OUTFILE" ) \
    || { echo "$dir could not be bundled: stopping" >&2; exit 1; }
  node -e "
    const outside = Object.keys(require('./$WORK/meta.json').inputs)
      .filter((file) => file.startsWith('..') || file.includes('node_modules'));
    if (outside.length) { console.error('$dir bundles files from outside its src/: ' + outside.join(', ')); process.exit(1); }
    new Function('module', 'exports', require('fs').readFileSync('$OUTFILE', 'utf8'));
  " || { echo "$dir does not bundle from its src/ alone into an entry: stopping" >&2; exit 1; }
done

# The core, for both kinds of Mac, beside main.js. Its build is kept between runs, and nothing in it names where it was
# built: the same sources make the same bytes.
CORE_SWIFT=(swift build --package-path source/deckit/deckit --product deckit -c release --arch arm64 --arch x86_64
  --scratch-path "$OUT/core" -Xswiftc -file-prefix-map -Xswiftc "$PWD/source/deckit/deckit=." -Xlinker -S)
"${CORE_SWIFT[@]}" --quiet || { echo "the core could not be built: stopping" >&2; exit 1; }
cp "$("${CORE_SWIFT[@]}" --show-bin-path)/deckit" "$LIB/deckit"

# The packages' bundles, each from its entry, and deckit.json, which says what they are.
node source/cli/bundle.js "$LIB" "$VERSION" "$SOURCE_HASH" || { echo "deckit could not be bundled: stopping" >&2; exit 1; }

# Byte for byte the same from the same sources, wherever built with the same Swift: the archive's hash is which deckit it
# is.
pack() {
  local from="$1" to="$2"
  chmod -R u=rwX,go=rX "$from"
  TZ=UTC0 find "$from" -exec touch -h -t 200001010000 {} +
  ( cd "$from" && find . -type f | LC_ALL=C sort > "$OLDPWD/$to.list" )
  ( cd "$from" && COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata --no-acls --uid 0 --gid 0 --uname "" --gname "" -cf - -T "$OLDPWD/$to.list" ) | gzip -n -9 > "$to"
  rm -f "$to.list"
  ( cd "$(dirname "$to")" && shasum -a 256 "$(basename "$to")" > "$(basename "$to").sha256" )
}
NAME="deckit-$VERSION.tgz"
pack "$LIB" "$WORK/$NAME"
rm -f "$OUT"/deckit-[0-9]*.tgz*
mv "$WORK/$NAME" "$WORK/$NAME.sha256" "$OUT/"
ARCHIVE="$OUT/$NAME"

echo "built deckit $VERSION (sources $SOURCE_HASH)"
echo "  $ARCHIVE  $(cut -c1-12 < "$ARCHIVE.sha256")  $(du -h "$ARCHIVE" | cut -f1 | tr -d ' ')"
