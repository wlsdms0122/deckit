#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")/command" && pwd)"

usage() {
  cat <<TEXT
deckit: a library a host app embeds to take mods, the way a game does

  build [app]      the deckit archive, into .build/: what an app embeds; with app, Deckit.app from it too
  check            hold the packages' files to how they are laid out
  dev [<Electron's arguments>]
                   Deckit.app from the sources, built again when one changes
  test [--port <port>]
                   deckit built, then the core's tests, then Deckit.app from it, through its scenario
  install          Deckit.app built, then put into /Applications

For work on deckit itself, and kept out of manifest.toml:

  engine <mod>     build a mod's editing engine again (editor, note)
  resize start|stop <port>
                   what a window resize a person makes draws, in a Deckit.app run with --inspect=<port>

TEXT
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  ""|-h|--help|help) usage ;;
  *)
    [ -x "$HERE/$cmd" ] || { echo "unknown command: $cmd" >&2; usage >&2; exit 2; }
    # Help asked for anywhere after a command is shown, and nothing runs.
    for arg in "$@"; do
      case "$arg" in -h|--help) usage; exit 0 ;; esac
    done
    exec "$HERE/$cmd" "$@"
    ;;
esac
