#!/usr/bin/env node
// deckit's command line, for an app that embeds it. The app's modules (its config.js and folders.js) come before
// the command, each with --app.
const path = require('path');

const here = __dirname;
const args = process.argv.slice(2);
const app = [];
while (args[0] === '--app') {
    const [flag, file] = args.splice(0, 2);
    if (!file) fail(`${flag} needs a file`);
    app.push(path.resolve(file));
}
const [command, ...rest] = args;

load(path.join(here, '..', 'registry.js'), "deckit's registry");
for (const file of app) load(file, 'the app module');
load(path.join(here, '..', 'cli.js'), "deckit's command line bundle");
load(path.join(here, 'commands.js'), "deckit's commands");
Promise.resolve()
    .then(() => DeckitModule.use(['cli/commands'], (COMMANDS) => COMMANDS.run({ command, args: rest })))
    .then((code) => (process.exitCode = code))
    .catch((error) => {
        process.stderr.write(`${error.message || error}\n`);
        process.exitCode = 1;
    });

function load(file, what) {
    try {
        require(file);
    } catch (error) {
        fail(`cannot load ${what} ${file}: ${String(error.message || error).split('\n')[0]}`);
    }
}

function fail(message) {
    process.stderr.write(message + '\n');
    process.exit(1);
}
